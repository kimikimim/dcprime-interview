---
import "../styles/global.css";

interface Props {
  title: string;
  active?: "main" | "questions";
}

const { title, active } = Astro.props;

const navItems = [
  { href: "/main", label: "메인", key: "main" },
  { href: "/questions", label: "문제은행", key: "questions" },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · 대치프라임 면접반</title>
  </head>
  <body class="font-sans text-gray-800 bg-gray-50 min-h-screen">
    <header class="bg-white border-b border-gray-100 sticky top-0 z-10">
      <div class="max-w-4xl mx-auto px-5 h-16 flex items-center justify-between">
        <div class="flex items-center gap-8">
          <span class="font-bold text-gray-900 tracking-tight">DC Prime 면접반</span>
          <nav class="hidden sm:flex items-center gap-1">
            {navItems.map((item) => (
              <a
                href={item.href}
                class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                  active === item.key
                    ? "bg-brand-light text-brand-dark"
                    : "text-gray-500 hover:text-gray-900"
                }`}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
        <div class="flex items-center gap-3">
          <span id="student-name-badge" class="text-sm text-gray-500 hidden sm:inline"></span>
          <button id="logout-btn" class="text-sm text-gray-400 hover:text-gray-700 transition-colors">로그아웃</button>
        </div>
      </div>
      <nav class="sm:hidden flex border-t border-gray-100">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`flex-1 text-center py-2.5 text-sm font-medium transition-colors ${
              active === item.key ? "text-brand-dark bg-brand-light" : "text-gray-500"
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main class="max-w-4xl mx-auto px-5 py-8">
      <slot />
    </main>

    <script>
      type StudentSession = { id: string; name: string; school: string | null; grade: string | null };

      function getSession(): StudentSession | null {
        const raw = sessionStorage.getItem("student_session");
        if (!raw) return null;
        try {
          return JSON.parse(raw) as StudentSession;
        } catch {
          return null;
        }
      }

      const session = getSession();
      if (!session) {
        window.location.href = "/";
      } else {
        const badge = document.getElementById("student-name-badge");
        if (badge) badge.textContent = `${session.name}님`;
      }

      document.getElementById("logout-btn")?.addEventListener("click", () => {
        sessionStorage.removeItem("student_session");
        window.location.href = "/";
      });
    </script>
  </body>
</html>
