---
import "../styles/global.css";
import "../styles/panel.css";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <meta name="robots" content="noindex, nofollow" />
    <title>대치프라임 면접반</title>
  </head>
  <body class="admin-body">
    <header class="admin-header">
      <div class="admin-header-inner">
        <div class="admin-header-left">
          <img src="/favicon-circle.png" alt="대치프라임" style="width:34px;height:34px;border-radius:50%;object-fit:cover" />
          <div>
            <p class="header-name" id="headerName">학생</p>
          </div>
        </div>
        <div class="admin-header-right">
          <button class="hamburger-btn" id="hamburgerBtn" title="메뉴">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <button class="icon-btn" id="logoutBtn" title="로그아웃">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>

      <div class="tab-bar">
        <button class="tab-btn active" data-tab="goals">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M9 11l3 3 8-8M20 12v6a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          나의 지원현황
        </button>
        <button class="tab-btn" data-tab="common">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M21 11.5a8.38 8.38 0 01-4.5 7.4 8.5 8.5 0 01-9 0A8.38 8.38 0 013 11.5a8.5 8.5 0 015-7.6 8.38 8.38 0 018 0 8.5 8.5 0 015 7.6z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          공통 질문
        </button>
        <button class="tab-btn" data-tab="personal">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/><path d="M4 21a8 8 0 0116 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          개별 질문
        </button>
        <button class="tab-btn" data-tab="goalsetting">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          목표
        </button>
        <button class="tab-btn" data-tab="mock">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="currentColor" stroke-width="2"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          모의면접
        </button>
        <button class="tab-bar-logout" id="hamburgerLogoutBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          로그아웃
        </button>
      </div>
    </header>

    <!-- 목표 -->
    <div class="tab-panel active" id="tabGoals">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">나의 지원 현황</h2>
        </div>
        <div id="applicationCards" style="display:flex;flex-direction:column;gap:10px">
          <p class="empty-text">불러오는 중...</p>
        </div>
      </div>
    </div>

    <!-- 공통 질문 -->
    <div class="tab-panel" id="tabCommon">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">공통 질문</h2>
        </div>
        <div id="commonQuestionList" style="display:flex;flex-direction:column;gap:10px">
          <p class="empty-text">불러오는 중...</p>
        </div>
      </div>
    </div>

    <!-- 개별 질문 -->
    <div class="tab-panel" id="tabPersonal">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">개별 질문</h2>
        </div>
        <div id="personalQuestionList" style="display:flex;flex-direction:column;gap:10px">
          <p class="empty-text">불러오는 중...</p>
        </div>
      </div>
    </div>

    <!-- 목표설정 (오늘의 목표) -->
    <div class="tab-panel" id="tabGoalSetting">
      <div class="admin-panel">
        <div class="gl-wrap">
          <div class="gl-date" id="glDate">오늘</div>
          <div class="gl-progress">
            <div class="gl-bar"><div class="gl-bar-fill" id="glBarFill"></div></div>
            <span class="gl-rate" id="glRate">0%</span>
          </div>
          <div class="gl-add">
            <input id="glInput" class="gl-input" type="text" placeholder="오늘 할 일 추가 (예: 문제은행 3개 풀기)" maxlength="100" />
            <button id="glAddBtn" class="gl-add-btn">추가</button>
          </div>
          <div id="glList"></div>
          <p class="empty-text">아침에 목표를 적고, 완료하면 체크하세요.</p>
        </div>
      </div>
    </div>

    <!-- 모의면접 -->
    <div class="tab-panel" id="tabMock">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">모의면접</h2>
        </div>

        <!-- 대기 화면 -->
        <div id="mockIdle" class="card" style="text-align:center;padding:32px 20px">
          <p style="font-size:15px;color:var(--black);line-height:1.6;margin-bottom:6px">10~15분 랜덤 시간의 모의면접을 진행합니다.</p>
          <p class="empty-text" style="margin-bottom:20px">자기소개 → 본질문 → 꼬리질문 → 마무리 질문 순서로 진행되며,<br />답변은 음성으로 녹음됩니다. 마이크 권한을 허용해주세요.</p>
          <p class="empty-text" id="mockAssignedNote" style="margin-bottom:14px">배정 여부를 확인하는 중...</p>
          <button class="btn-primary-sm hidden" id="mockStartBtn" style="padding:0 24px;height:40px;font-size:14px">모의면접 시작</button>
        </div>

        <!-- 진행 화면 -->
        <div id="mockActive" class="card hidden">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
            <span class="tag-pill" id="mockProgress"></span>
            <span class="student-mgmt-meta" id="mockTimer">남은 시간 --:--</span>
          </div>
          <p style="font-size:16px;font-weight:700;color:var(--black);line-height:1.6;margin-bottom:20px" id="mockQuestionText"></p>
          <div style="display:flex;align-items:center;gap:12px">
            <button class="btn-primary-sm" id="mockRecordBtn" style="padding:0 20px;height:40px;font-size:14px">답변 녹음 시작</button>
            <span class="student-mgmt-meta" id="mockRecordStatus"></span>
          </div>
        </div>

        <!-- 완료 화면 -->
        <div id="mockDone" class="card hidden" style="text-align:center;padding:32px 20px">
          <p style="font-size:15px;color:var(--black);margin-bottom:20px">모의면접이 종료되었습니다. 수고하셨어요!</p>
          <button class="btn-primary-sm" id="mockRestartBtn" style="padding:0 24px;height:40px;font-size:14px">다시 시작</button>
        </div>
      </div>
    </div>

    <script>
      import { supabase, supabaseUrl, supabaseAnonKey } from "../lib/supabase";

      type StudentSession = { id: string; name: string; school: string | null };

      const raw = sessionStorage.getItem("student_session");
      if (!raw) {
        window.location.href = "/";
      }
      const session: StudentSession = raw ? JSON.parse(raw) : { id: "", name: "학생", school: null };

      function $<T extends HTMLElement>(id: string): T {
        return document.getElementById(id) as T;
      }
      function escapeHtml(str: string): string {
        const div = document.createElement("div");
        div.textContent = str;
        return div.innerHTML;
      }

      const headerNameEl = $("headerName");
      headerNameEl.textContent = `${session.name} 학생`;

      $("logoutBtn").addEventListener("click", () => {
        sessionStorage.removeItem("student_session");
        window.location.href = "/";
      });

      // ── 탭 전환 + 햄버거 메뉴 ──
      const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
      const panels: Record<string, HTMLElement> = {
        goals: $("tabGoals"),
        common: $("tabCommon"),
        personal: $("tabPersonal"),
        goalsetting: $("tabGoalSetting"),
        mock: $("tabMock"),
      };
      const tabBar = document.querySelector<HTMLElement>(".tab-bar")!;
      const menuBackdrop = document.createElement("div");
      menuBackdrop.className = "menu-backdrop";
      document.body.appendChild(menuBackdrop);
      const closeMenu = () => { tabBar.classList.remove("open"); menuBackdrop.classList.remove("show"); };
      const openMenu = () => { tabBar.classList.add("open"); menuBackdrop.classList.add("show"); };

      function activateTab(t: string) {
        tabBtns.forEach((x) => x.classList.toggle("active", x.dataset.tab === t));
        Object.entries(panels).forEach(([k, p]) => p.classList.toggle("active", k === t));
        closeMenu();
      }

      tabBtns.forEach((b) => b.addEventListener("click", () => activateTab(b.dataset.tab!)));

      $("hamburgerBtn").addEventListener("click", (e) => {
        e.stopPropagation();
        tabBar.classList.contains("open") ? closeMenu() : openMenu();
      });
      menuBackdrop.addEventListener("click", closeMenu);
      $("hamburgerLogoutBtn").addEventListener("click", () => $("logoutBtn").click());

      // ── 목표: 나의 지원 현황 (관리자가 학생관리에서 입력한 "학교명,전형,학과,면접일" 파싱) ──
      type Application = { university: string; track: string; department: string; interviewDate: string };

      function parseApplications(raw: string | null): Application[] {
        if (!raw) return [];
        return raw
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const [university, track, department, interviewDate] = line.split(",").map((p) => p.trim());
            return { university: university ?? "", track: track ?? "", department: department ?? "", interviewDate: interviewDate ?? "" };
          })
          .filter((app) => app.university);
      }

      function daysUntil(dateStr: string): number {
        const target = new Date(dateStr + "T00:00:00");
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        return Math.round((target.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
      }

      function ddayPill(days: number | null): string {
        if (days === null) return "";
        if (days < 0) return `<span class="tag-pill tag-pill--muted">종료</span>`;
        if (days <= 7) return `<span class="tag-pill tag-pill--danger">D-${days}</span>`;
        return `<span class="tag-pill">D-${days}</span>`;
      }

      function renderApplications() {
        const container = $("applicationCards");
        const applications = parseApplications(session.school);

        if (applications.length === 0) {
          container.innerHTML = `<p class="empty-text">등록된 지원 현황이 없습니다.</p>`;
          return;
        }

        const sorted = [...applications].sort((a, b) => {
          const da = a.interviewDate ? daysUntil(a.interviewDate) : Infinity;
          const db = b.interviewDate ? daysUntil(b.interviewDate) : Infinity;
          return da - db;
        });

        container.innerHTML = sorted
          .map((app) => `
            <div class="card">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px">
                <div>
                  <p class="student-mgmt-name">${escapeHtml(app.university)}</p>
                  <p class="student-mgmt-meta">${escapeHtml(app.department)} · ${escapeHtml(app.track)}</p>
                </div>
                ${app.interviewDate ? ddayPill(daysUntil(app.interviewDate)) : ""}
              </div>
              ${app.interviewDate ? `<p class="empty-text" style="text-align:left;padding:0 0 10px">면접일 ${escapeHtml(app.interviewDate)}</p>` : ""}
              <button class="goto-bank-btn" data-university="${escapeHtml(app.university)}"
                style="background:none;border:none;padding:0;font-size:12px;font-weight:700;color:var(--blue);cursor:pointer">
                예상 질문 보러가기 →
              </button>
            </div>
          `)
          .join("");

        container.querySelectorAll<HTMLButtonElement>(".goto-bank-btn").forEach((btn) =>
          btn.addEventListener("click", () => activateTab("mock"))
        );
      }

      // ── 공통 질문 / 개별 질문 (관리자가 문제출제에서 등록) ──
      type CustomQuestion = { id: string; question_text: string };
      let myCustomAnswers: Record<string, string> = {};
      let myCustomAudioPaths: Record<string, string | null> = {};
      const activeCustomRecorders: Record<string, MediaRecorder> = {};

      function recordingsUrl(path: string): string {
        return supabase.storage.from("recordings").getPublicUrl(path).data.publicUrl;
      }

      async function loadCustomAnswers() {
        const { data, error } = await supabase
          .from("custom_answers")
          .select("custom_question_id, answer_text, audio_path")
          .eq("student_id", session.id);
        if (error) {
          console.error(error);
          return;
        }
        myCustomAnswers = Object.fromEntries((data ?? []).map((a: any) => [a.custom_question_id, a.answer_text]));
        myCustomAudioPaths = Object.fromEntries((data ?? []).map((a: any) => [a.custom_question_id, a.audio_path]));
      }

      function renderCustomQuestionList(containerId: string, questions: CustomQuestion[], emptyMessage: string, kind: "common" | "personal") {
        const list = $(containerId);
        if (questions.length === 0) {
          list.innerHTML = `<p class="empty-text">${emptyMessage}</p>`;
          return;
        }
        list.innerHTML = questions
          .map((q) => {
            const audioPath = myCustomAudioPaths[q.id];
            return `
              <div class="card">
                <p style="font-size:14px;color:var(--black);line-height:1.6;margin-bottom:12px">${escapeHtml(q.question_text)}</p>
                <textarea class="form-input custom-answer-input" data-question-id="${q.id}" rows="3"
                  placeholder="이 질문에 대한 나만의 답변을 적어보세요"
                  style="height:auto;padding:10px 12px;resize:vertical;line-height:1.5">${escapeHtml(myCustomAnswers[q.id] ?? "")}</textarea>
                <div style="display:flex;align-items:center;gap:10px;margin-top:8px">
                  <button class="btn-primary-sm save-custom-answer-btn" data-question-id="${q.id}">답변 저장</button>
                  <span class="custom-answer-status" data-question-id="${q.id}" style="font-size:12px;color:var(--gray-4)"></span>
                </div>
                <div style="display:flex;align-items:center;gap:10px;margin-top:10px;padding-top:10px;border-top:1px solid var(--gray-6)">
                  <button class="btn-primary-sm record-custom-btn" data-question-id="${q.id}" data-kind="${kind}">${audioPath ? "다시 녹음" : "음성 답변 녹음"}</button>
                  <span class="custom-record-status" data-question-id="${q.id}" style="font-size:12px;color:var(--gray-4)"></span>
                </div>
                ${audioPath ? `<audio controls src="${recordingsUrl(audioPath)}" style="width:100%;margin-top:10px;height:36px"></audio>` : ""}
              </div>
            `;
          })
          .join("");

        list.querySelectorAll<HTMLButtonElement>(".save-custom-answer-btn").forEach((btn) =>
          btn.addEventListener("click", () => saveCustomAnswer(btn.dataset.questionId!))
        );
        list.querySelectorAll<HTMLButtonElement>(".record-custom-btn").forEach((btn) =>
          btn.addEventListener("click", () => toggleCustomRecording(btn.dataset.questionId!, btn.dataset.kind as "common" | "personal"))
        );
      }

      async function saveCustomAnswer(questionId: string) {
        const textarea = document.querySelector<HTMLTextAreaElement>(`.custom-answer-input[data-question-id="${questionId}"]`)!;
        const statusEl = document.querySelector<HTMLElement>(`.custom-answer-status[data-question-id="${questionId}"]`)!;
        const btn = document.querySelector<HTMLButtonElement>(`.save-custom-answer-btn[data-question-id="${questionId}"]`)!;
        const answerText = textarea.value.trim();

        btn.disabled = true;
        statusEl.textContent = "저장 중...";

        const { error } = await supabase
          .from("custom_answers")
          .upsert({ student_id: session.id, custom_question_id: questionId, answer_text: answerText }, { onConflict: "student_id,custom_question_id" });

        btn.disabled = false;

        if (error) {
          statusEl.textContent = "저장 실패";
          console.error(error);
          return;
        }
        myCustomAnswers[questionId] = answerText;
        statusEl.textContent = "저장됨 ✓";
        setTimeout(() => { if (statusEl.textContent === "저장됨 ✓") statusEl.textContent = ""; }, 2000);
      }

      async function toggleCustomRecording(questionId: string, kind: "common" | "personal") {
        const btn = document.querySelector<HTMLButtonElement>(`.record-custom-btn[data-question-id="${questionId}"]`)!;
        const statusEl = document.querySelector<HTMLElement>(`.custom-record-status[data-question-id="${questionId}"]`)!;

        const existing = activeCustomRecorders[questionId];
        if (existing) {
          existing.stop();
          return;
        }

        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          const mimeType = MediaRecorder.isTypeSupported("audio/webm") ? "audio/webm" : "audio/mp4";
          const recorder = new MediaRecorder(stream, { mimeType });
          const chunks: BlobPart[] = [];
          recorder.ondataavailable = (e) => {
            if (e.data.size > 0) chunks.push(e.data);
          };
          recorder.onstop = async () => {
            stream.getTracks().forEach((t) => t.stop());
            delete activeCustomRecorders[questionId];
            btn.disabled = true;
            statusEl.textContent = "업로드 중...";

            const blob = new Blob(chunks, { type: mimeType });
            const ext = mimeType.includes("webm") ? "webm" : "m4a";
            const path = `${kind}/${session.id}/${questionId}.${ext}`;

            const { error: uploadError } = await supabase.storage.from("recordings").upload(path, blob, {
              contentType: mimeType,
              upsert: true,
            });
            if (uploadError) {
              btn.disabled = false;
              statusEl.textContent = "업로드 실패";
              console.error(uploadError);
              return;
            }

            const { error } = await supabase
              .from("custom_answers")
              .upsert({ student_id: session.id, custom_question_id: questionId, audio_path: path }, { onConflict: "student_id,custom_question_id" });

            btn.disabled = false;
            if (error) {
              statusEl.textContent = "저장 실패";
              console.error(error);
              return;
            }
            myCustomAudioPaths[questionId] = path;
            statusEl.textContent = "";
            if (kind === "common") loadCommonQuestions();
            else loadPersonalQuestions();
          };
          recorder.start();
          activeCustomRecorders[questionId] = recorder;
          btn.textContent = "녹음 정지";
          statusEl.textContent = "녹음 중...";
        } catch (err) {
          alert("마이크 권한이 필요합니다.");
          console.error(err);
        }
      }

      async function loadCommonQuestions() {
        await loadCustomAnswers();
        const { data, error } = await supabase
          .from("custom_questions")
          .select("*")
          .eq("visibility", "common")
          .order("created_at", { ascending: false });
        if (error) {
          $("commonQuestionList").innerHTML = `<p class="empty-text">불러오기에 실패했습니다.</p>`;
          console.error(error);
          return;
        }
        renderCustomQuestionList("commonQuestionList", data ?? [], "등록된 공통 질문이 없습니다.", "common");
      }

      async function loadPersonalQuestions() {
        await loadCustomAnswers();
        const { data, error } = await supabase
          .from("custom_question_targets")
          .select("custom_questions(id, question_text, created_at)")
          .eq("student_id", session.id);
        if (error) {
          $("personalQuestionList").innerHTML = `<p class="empty-text">불러오기에 실패했습니다.</p>`;
          console.error(error);
          return;
        }
        const questions = (data ?? [])
          .map((row: any) => row.custom_questions)
          .filter(Boolean)
          .sort((a: any, b: any) => (a.created_at < b.created_at ? 1 : -1));
        renderCustomQuestionList("personalQuestionList", questions, "등록된 개별 질문이 없습니다.", "personal");
      }

      // ── 모의면접 ──
      const MOCK_INTRO_PROMPT = "1분 내외로 자기소개를 해주세요.";
      const MOCK_CLOSING_PROMPT = "마지막으로 강조하고 싶은 점이나 하고 싶은 말이 있다면 자유롭게 말씀해주세요.";
      const MOCK_FALLBACK_FOLLOWUPS = [
        "방금 답변한 내용 중 가장 어려웠던 부분을 좀 더 구체적으로 설명해주세요.",
        "그 경험에서 배운 점을 다른 상황에도 적용한다면 어떻게 적용하겠습니까?",
        "그 결론에 도달하게 된 근거를 조금 더 자세히 말해주세요.",
      ];

      type MockItemType = "intro" | "main" | "followup" | "closing";
      type MockItem = { type: MockItemType; questionText: string; sourceQuestionId?: string | null };
      type MockPoolQuestion = { id: string; question_text: string };

      let mockSessionId: string | null = null;
      let mockPlannedDuration = 0;
      let mockTimerInterval: number | null = null;
      let mockDeadline = 0;
      let mockSequenceOrder = 0;
      let mockPairsRemaining = 0;
      let mockPool: MockPoolQuestion[] = [];
      let mockCurrentItem: MockItem | null = null;
      let mockMediaRecorder: MediaRecorder | null = null;
      let mockAudioChunks: BlobPart[] = [];
      let mockIsRecording = false;

      function mockProgressLabel(type: MockItemType): string {
        if (type === "intro") return "자기소개";
        if (type === "main") return "본질문";
        if (type === "followup") return "꼬리질문";
        return "마무리 질문";
      }

      function pickRandom<T>(arr: T[]): T {
        return arr[Math.floor(Math.random() * arr.length)];
      }

      async function loadMockQuestionPool(): Promise<MockPoolQuestion[]> {
        const [{ data: commonData }, { data: targetData }] = await Promise.all([
          supabase.from("custom_questions").select("id, question_text").eq("visibility", "common"),
          supabase.from("custom_question_targets").select("custom_questions(id, question_text)").eq("student_id", session.id),
        ]);
        const common = (commonData ?? []) as MockPoolQuestion[];
        const individual = ((targetData ?? []) as any[]).map((r) => r.custom_questions).filter(Boolean) as MockPoolQuestion[];
        return [...common, ...individual];
      }

      async function checkMockAssignment() {
        const { data, error } = await supabase
          .from("mock_sessions")
          .select("id, planned_duration_seconds")
          .eq("student_id", session.id)
          .eq("status", "assigned")
          .order("started_at", { ascending: true })
          .limit(1)
          .maybeSingle();

        if (error) console.error(error);

        if (data) {
          mockSessionId = data.id;
          mockPlannedDuration = data.planned_duration_seconds;
          $("mockAssignedNote").textContent = "선생님이 배정한 모의면접이 있습니다.";
          $("mockStartBtn").classList.remove("hidden");
        } else {
          mockSessionId = null;
          $("mockAssignedNote").textContent = "아직 배정된 모의면접이 없습니다. 선생님께 문의해주세요.";
          $("mockStartBtn").classList.add("hidden");
        }
      }

      async function startMockSession() {
        if (!mockSessionId) return;

        mockPool = await loadMockQuestionPool();
        if (mockPool.length === 0) {
          alert("아직 등록된 질문이 없습니다. 관리자에게 문의해주세요.");
          return;
        }

        const { error } = await supabase
          .from("mock_sessions")
          .update({ status: "in_progress", started_at: new Date().toISOString() })
          .eq("id", mockSessionId);
        if (error) {
          alert("모의면접 시작에 실패했습니다: " + error.message);
          return;
        }

        mockSequenceOrder = 0;
        mockPairsRemaining = 1 + Math.round(Math.random()); // 1~2개
        mockDeadline = Date.now() + mockPlannedDuration * 1000;

        $("mockIdle").classList.add("hidden");
        $("mockDone").classList.add("hidden");
        $("mockActive").classList.remove("hidden");

        startMockTimer();
        showMockItem({ type: "intro", questionText: MOCK_INTRO_PROMPT });
      }

      function startMockTimer() {
        updateMockTimerLabel();
        mockTimerInterval = window.setInterval(updateMockTimerLabel, 1000);
      }

      function updateMockTimerLabel() {
        const remainMs = mockDeadline - Date.now();
        if (remainMs <= 0) {
          $("mockTimer").textContent = "남은 시간 00:00";
          if (mockTimerInterval) window.clearInterval(mockTimerInterval);
          if (mockCurrentItem && mockCurrentItem.type !== "closing" && !mockIsRecording) {
            mockPairsRemaining = 0;
            showMockItem({ type: "closing", questionText: MOCK_CLOSING_PROMPT });
          }
          return;
        }
        const totalSec = Math.floor(remainMs / 1000);
        const m = String(Math.floor(totalSec / 60)).padStart(2, "0");
        const s = String(totalSec % 60).padStart(2, "0");
        $("mockTimer").textContent = `남은 시간 ${m}:${s}`;
      }

      function showMockItem(item: MockItem) {
        mockCurrentItem = item;
        mockSequenceOrder += 1;
        $("mockQuestionText").textContent = item.questionText;
        $("mockProgress").textContent = mockProgressLabel(item.type);
        $<HTMLButtonElement>("mockRecordBtn").textContent = "답변 녹음 시작";
        $<HTMLButtonElement>("mockRecordBtn").disabled = false;
        $("mockRecordStatus").textContent = "";
      }

      async function toggleMockRecording() {
        if (!mockIsRecording) await startMockRecording();
        else stopMockRecording();
      }

      async function startMockRecording() {
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          const mimeType = MediaRecorder.isTypeSupported("audio/webm") ? "audio/webm" : "audio/mp4";
          mockMediaRecorder = new MediaRecorder(stream, { mimeType });
          mockAudioChunks = [];
          mockMediaRecorder.ondataavailable = (e) => {
            if (e.data.size > 0) mockAudioChunks.push(e.data);
          };
          mockMediaRecorder.onstop = () => {
            stream.getTracks().forEach((t) => t.stop());
            handleMockRecordingStop(mimeType);
          };
          mockMediaRecorder.start();
          mockIsRecording = true;
          $<HTMLButtonElement>("mockRecordBtn").textContent = "녹음 정지";
          $("mockRecordStatus").textContent = "녹음 중...";
        } catch (err) {
          alert("마이크 권한이 필요합니다.");
          console.error(err);
        }
      }

      function stopMockRecording() {
        if (mockMediaRecorder && mockMediaRecorder.state !== "inactive") {
          mockMediaRecorder.stop();
        }
        mockIsRecording = false;
      }

      function blobToBase64(blob: Blob): Promise<string> {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onloadend = () => resolve((reader.result as string).split(",")[1] ?? "");
          reader.onerror = reject;
          reader.readAsDataURL(blob);
        });
      }

      async function handleMockRecordingStop(mimeType: string) {
        const item = mockCurrentItem!;
        $<HTMLButtonElement>("mockRecordBtn").disabled = true;
        $("mockRecordStatus").textContent = "처리 중...";

        const blob = new Blob(mockAudioChunks, { type: mimeType });
        const ext = mimeType.includes("webm") ? "webm" : "m4a";
        const path = `mock/${mockSessionId}/${mockSequenceOrder}-${item.type}.${ext}`;

        const { error: uploadError } = await supabase.storage.from("recordings").upload(path, blob, {
          contentType: mimeType,
          upsert: true,
        });
        if (uploadError) console.error("녹음 업로드 실패:", uploadError);

        let transcript: string | null = null;
        let followupQuestion: string | null = null;

        if (item.type === "main") {
          try {
            const audioBase64 = await blobToBase64(blob);
            const res = await fetch(`${supabaseUrl}/functions/v1/generate-followup`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${supabaseAnonKey}`,
                apikey: supabaseAnonKey,
              },
              body: JSON.stringify({ questionText: item.questionText, audioBase64, mimeType }),
            });
            if (res.ok) {
              const json = await res.json();
              transcript = json.transcript ?? null;
              followupQuestion = json.followup_question ?? null;
            } else {
              console.error("꼬리질문 생성 실패:", await res.text());
            }
          } catch (err) {
            console.error(err);
          }
          if (!followupQuestion) followupQuestion = pickRandom(MOCK_FALLBACK_FOLLOWUPS);
        }

        await supabase.from("mock_session_items").insert({
          session_id: mockSessionId,
          sequence_order: mockSequenceOrder,
          item_type: item.type,
          question_text: item.questionText,
          source_question_id: item.sourceQuestionId ?? null,
          audio_path: uploadError ? null : path,
          transcript,
        });

        await advanceMockSession(item, followupQuestion);
      }

      async function advanceMockSession(prevItem: MockItem, followupQuestion: string | null) {
        if (prevItem.type === "intro") {
          goToNextMainOrClosing();
          return;
        }
        if (prevItem.type === "main") {
          showMockItem({ type: "followup", questionText: followupQuestion ?? pickRandom(MOCK_FALLBACK_FOLLOWUPS) });
          return;
        }
        if (prevItem.type === "followup") {
          mockPairsRemaining -= 1;
          goToNextMainOrClosing();
          return;
        }
        if (prevItem.type === "closing") {
          await finishMockSession();
        }
      }

      function goToNextMainOrClosing() {
        if (mockPairsRemaining > 0 && mockPool.length > 0 && Date.now() < mockDeadline) {
          const idx = Math.floor(Math.random() * mockPool.length);
          const q = mockPool.splice(idx, 1)[0];
          showMockItem({ type: "main", questionText: q.question_text, sourceQuestionId: q.id });
        } else {
          showMockItem({ type: "closing", questionText: MOCK_CLOSING_PROMPT });
        }
      }

      async function finishMockSession() {
        if (mockTimerInterval) window.clearInterval(mockTimerInterval);
        await supabase
          .from("mock_sessions")
          .update({ status: "completed", ended_at: new Date().toISOString() })
          .eq("id", mockSessionId!);
        $("mockActive").classList.add("hidden");
        $("mockDone").classList.remove("hidden");
      }

      $("mockStartBtn").addEventListener("click", startMockSession);
      $("mockRecordBtn").addEventListener("click", toggleMockRecording);
      $("mockRestartBtn").addEventListener("click", () => {
        $("mockDone").classList.add("hidden");
        $("mockIdle").classList.remove("hidden");
        checkMockAssignment();
      });
      document.querySelector<HTMLButtonElement>('.tab-btn[data-tab="mock"]')?.addEventListener("click", checkMockAssignment);

      // ── 오늘의 목표 ──
      function todayStr(): string {
        const d = new Date();
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      }

      type Goal = { id: string; text: string; done: boolean };

      async function loadGoals() {
        const today = todayStr();
        const d = new Date();
        $("glDate").textContent = `${today} (${["일", "월", "화", "수", "목", "금", "토"][d.getDay()]})`;

        const { data, error } = await supabase
          .from("goals")
          .select("*")
          .eq("student_id", session.id)
          .eq("date", today)
          .order("sort_order")
          .order("created_at");

        if (error) {
          $("glList").innerHTML = `<p class="empty-text">불러오기에 실패했습니다.</p>`;
          console.error(error);
          return;
        }
        renderGoals(data ?? []);
      }

      function renderGoals(goals: Goal[]) {
        const list = $("glList");
        const done = goals.filter((g) => g.done).length;
        const rate = goals.length ? Math.round((done / goals.length) * 100) : 0;
        $("glBarFill").style.width = rate + "%";
        $("glRate").textContent = rate + "%";

        if (!goals.length) {
          list.innerHTML = `<p class="empty-text">오늘의 목표를 추가해보세요.</p>`;
          return;
        }

        list.innerHTML = goals
          .map(
            (g) => `
              <div class="gl-item">
                <div class="gl-check ${g.done ? "done" : ""}" data-id="${g.id}" data-done="${g.done ? 1 : 0}">${g.done ? "✓" : ""}</div>
                <span class="gl-text ${g.done ? "done" : ""}">${escapeHtml(g.text)}</span>
                <button class="gl-del" data-id="${g.id}">삭제</button>
              </div>
            `
          )
          .join("");

        list.querySelectorAll<HTMLElement>(".gl-check").forEach((c) =>
          c.addEventListener("click", async () => {
            await supabase.from("goals").update({ done: c.dataset.done === "0" }).eq("id", c.dataset.id!);
            loadGoals();
          })
        );
        list.querySelectorAll<HTMLButtonElement>(".gl-del").forEach((b) =>
          b.addEventListener("click", async () => {
            await supabase.from("goals").delete().eq("id", b.dataset.id!);
            loadGoals();
          })
        );
      }

      async function addGoal() {
        const input = $<HTMLInputElement>("glInput");
        const text = input.value.trim();
        if (!text) return;
        input.value = "";
        await supabase.from("goals").insert({ student_id: session.id, date: todayStr(), text });
        loadGoals();
      }
      $("glAddBtn").addEventListener("click", addGoal);
      $("glInput").addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key === "Enter") addGoal();
      });

      renderApplications();
      loadGoals();
      loadCommonQuestions();
      loadPersonalQuestions();
      checkMockAssignment();
    </script>
  </body>
</html>
