---
import StudentLayout from "../layouts/StudentLayout.astro";
---

<StudentLayout title="메인" active="main">
  <div class="flex items-baseline justify-between mb-6">
    <h1 class="text-xl font-bold text-gray-900">나의 지원 현황</h1>
    <span id="student-grade-badge" class="text-xs text-gray-400"></span>
  </div>

  <div id="application-cards" class="grid sm:grid-cols-2 gap-4">
    <p class="text-sm text-gray-400 col-span-2">불러오는 중...</p>
  </div>

  <p class="text-xs text-gray-300 mt-6 text-center">* 데모 버전 샘플 데이터입니다. 실제 지원 현황 연동은 다음 단계에서 추가됩니다.</p>
</StudentLayout>

<script>
  type StudentSession = { id: string; name: string; school: string | null; grade: string | null };

  // TODO: Phase 2에서 interview.applications 테이블로 교체
  const SAMPLE_APPLICATIONS = [
    { university: "서울대학교", department: "컴퓨터공학부", track: "지역균형", interviewDate: "2026-11-28" },
    { university: "연세대학교", department: "경영학과", track: "활동우수형", interviewDate: "2026-12-02" },
    { university: "고려대학교", department: "심리학과", track: "학업우수형", interviewDate: "2026-12-05" },
  ];

  function daysUntil(dateStr: string): number {
    const target = new Date(dateStr + "T00:00:00");
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    return Math.round((target.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
  }

  function ddayBadge(days: number): string {
    if (days < 0) return `<span class="text-xs font-semibold text-gray-400 bg-gray-100 px-2.5 py-1 rounded-full">종료</span>`;
    if (days <= 7) return `<span class="text-xs font-semibold text-white bg-red-400 px-2.5 py-1 rounded-full">D-${days}</span>`;
    return `<span class="text-xs font-semibold text-brand-dark bg-brand-light px-2.5 py-1 rounded-full">D-${days}</span>`;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  function render() {
    const container = document.getElementById("application-cards")!;
    const sorted = [...SAMPLE_APPLICATIONS].sort(
      (a, b) => daysUntil(a.interviewDate) - daysUntil(b.interviewDate)
    );

    container.innerHTML = sorted
      .map((app) => {
        const days = daysUntil(app.interviewDate);
        return `
          <div class="bg-white rounded-2xl shadow-sm p-5">
            <div class="flex items-start justify-between mb-3">
              <div>
                <p class="font-bold text-gray-900">${escapeHtml(app.university)}</p>
                <p class="text-sm text-gray-500">${escapeHtml(app.department)} · ${escapeHtml(app.track)}</p>
              </div>
              ${ddayBadge(days)}
            </div>
            <p class="text-xs text-gray-400 mb-4">면접일 ${escapeHtml(app.interviewDate)}</p>
            <a href="/questions?university=${encodeURIComponent(app.university)}"
               class="inline-block text-xs font-semibold text-brand-dark hover:opacity-70 transition-opacity">
              예상 질문 보러가기 →
            </a>
          </div>
        `;
      })
      .join("");
  }

  const raw = sessionStorage.getItem("student_session");
  if (raw) {
    const session = JSON.parse(raw) as StudentSession;
    const badge = document.getElementById("student-grade-badge");
    if (badge && session.school) badge.textContent = `${session.school} · ${session.grade ?? ""}`;
  }

  render();
</script>
