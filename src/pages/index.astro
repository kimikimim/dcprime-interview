---
import "../styles/global.css";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <meta name="robots" content="noindex, nofollow" />
    <title>대치프라임 면접반</title>
  </head>
  <body class="font-sans text-gray-900 bg-white sm:bg-gray-50">
    <div class="min-h-dvh flex items-center justify-center sm:py-10">
      <div
        id="card"
        class="w-full max-w-[390px] min-h-dvh sm:min-h-0 flex flex-col px-6 pt-14 pb-9 sm:px-11 sm:pt-14 sm:pb-11 sm:rounded-3xl sm:shadow-lg bg-white relative overflow-hidden"
      >
        <div class="flex items-center gap-2.5 mb-12">
          <img src="/favicon-circle.png" alt="대치프라임" class="w-9 h-9 rounded-full object-cover" />
          <span class="font-bold text-lg tracking-tight">DC Prime</span>
        </div>

        <div class="mb-9">
          <h1 id="pin-title" class="text-[28px] font-extrabold leading-tight tracking-tight mb-2">
            비밀번호를<br />입력하세요
          </h1>
          <p id="pin-subtitle" class="text-sm text-gray-400">4자리 번호를 눌러주세요</p>
        </div>

        <div id="pin-display" class="flex justify-center gap-4 mb-2.5">
          <div class="pin-dot w-3 h-3 rounded-full bg-gray-200 transition-transform"></div>
          <div class="pin-dot w-3 h-3 rounded-full bg-gray-200 transition-transform"></div>
          <div class="pin-dot w-3 h-3 rounded-full bg-gray-200 transition-transform"></div>
          <div class="pin-dot w-3 h-3 rounded-full bg-gray-200 transition-transform"></div>
        </div>

        <p id="error-msg" class="text-xs font-medium text-red-500 h-4 opacity-0 transition-opacity text-center"></p>

        <div class="grid grid-cols-3 gap-2 w-full max-w-[320px] mt-auto mx-auto">
          {["1", "2", "3", "4", "5", "6", "7", "8", "9"].map((n) => (
            <button
              type="button"
              data-num={n}
              class="numpad-btn aspect-[1.4] rounded-2xl bg-gray-50 hover:bg-gray-100 active:bg-gray-200 active:scale-95 transition-all flex flex-col items-center justify-center select-none"
            >
              <span class="text-2xl font-semibold">{n}</span>
              {n === "2" && <span class="text-[9px] text-gray-400 tracking-wider">ABC</span>}
              {n === "3" && <span class="text-[9px] text-gray-400 tracking-wider">DEF</span>}
              {n === "4" && <span class="text-[9px] text-gray-400 tracking-wider">GHI</span>}
              {n === "5" && <span class="text-[9px] text-gray-400 tracking-wider">JKL</span>}
              {n === "6" && <span class="text-[9px] text-gray-400 tracking-wider">MNO</span>}
              {n === "7" && <span class="text-[9px] text-gray-400 tracking-wider">PQRS</span>}
              {n === "8" && <span class="text-[9px] text-gray-400 tracking-wider">TUV</span>}
              {n === "9" && <span class="text-[9px] text-gray-400 tracking-wider">WXYZ</span>}
            </button>
          ))}
          <div class="aspect-[1.4]"></div>
          <button
            type="button"
            data-num="0"
            class="numpad-btn aspect-[1.4] rounded-2xl bg-gray-50 hover:bg-gray-100 active:bg-gray-200 active:scale-95 transition-all flex items-center justify-center select-none"
          >
            <span class="text-2xl font-semibold">0</span>
          </button>
          <button
            id="delete-btn"
            type="button"
            aria-label="지우기"
            class="aspect-[1.4] rounded-2xl hover:bg-gray-100 active:bg-gray-200 active:scale-95 transition-all flex items-center justify-center text-gray-400 select-none"
          >
            <svg width="22" height="16" viewBox="0 0 22 16" fill="none">
              <path d="M8 1H20C20.5523 1 21 1.44772 21 2V14C21 14.5523 20.5523 15 20 15H8L1 8L8 1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M13 6L17 10M17 6L13 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <div id="loading-overlay" class="hidden absolute inset-0 bg-white/90 backdrop-blur-sm flex flex-col items-center justify-center gap-3 text-sm font-medium text-gray-500 text-center px-6">
          <div class="w-8 h-8 border-[3px] border-gray-200 border-t-brand rounded-full animate-spin"></div>
          <span id="loading-text">확인 중...</span>
        </div>
      </div>
    </div>

    <style>
      @keyframes shake {
        10%, 90% { transform: translateX(-1px); }
        20%, 80% { transform: translateX(2px); }
        30%, 50%, 70% { transform: translateX(-4px); }
        40%, 60% { transform: translateX(4px); }
      }
      #pin-display.shake { animation: shake 0.5s ease; }
      .pin-dot.filled { background-color: var(--color-brand); transform: scale(1.15); }
      .pin-dot.error { background-color: #f04452; }
    </style>

    <script>
      import { supabase } from "../lib/supabase";

      const PIN_LENGTH = 4;
      let pin = "";
      let busy = false;

      function $<T extends HTMLElement>(id: string): T {
        return document.getElementById(id) as T;
      }

      const dots = Array.from(document.querySelectorAll<HTMLElement>(".pin-dot"));
      const pinDisplay = $("pin-display");
      const errorMsg = $("error-msg");
      const loadingOverlay = $("loading-overlay");
      const loadingText = $("loading-text");

      // 이미 로그인되어 있으면 바로 이동
      if (sessionStorage.getItem("student_session")) {
        window.location.href = "/main";
      } else if (sessionStorage.getItem("admin_authed") === "ok") {
        window.location.href = "/admin";
      }

      function updateDots() {
        dots.forEach((d, i) => {
          d.classList.toggle("filled", i < pin.length);
          d.classList.remove("error");
        });
      }

      function showError(msg: string) {
        dots.forEach((d) => d.classList.add("error"));
        pinDisplay.classList.remove("shake");
        void pinDisplay.offsetWidth;
        pinDisplay.classList.add("shake");
        errorMsg.textContent = msg;
        errorMsg.style.opacity = "1";
        setTimeout(() => {
          pin = "";
          updateDots();
          errorMsg.style.opacity = "0";
        }, 1400);
      }

      async function submit() {
        if (busy) return;
        busy = true;
        loadingText.textContent = "확인 중...";
        loadingOverlay.classList.remove("hidden");

        const { data: isAdmin, error: adminError } = await supabase.rpc("verify_admin_password", { p_pw: pin });
        if (!adminError && isAdmin === true) {
          sessionStorage.setItem("admin_authed", "ok");
          loadingText.textContent = "관리자님, 환영해요!";
          setTimeout(() => {
            window.location.href = "/admin";
          }, 700);
          return;
        }

        const { data, error } = await supabase.rpc("verify_student_login", { p_pw: pin });
        if (!error && data && data.length > 0) {
          sessionStorage.setItem("student_session", JSON.stringify(data[0]));
          loadingText.textContent = `${data[0].name}님, 환영해요!`;
          setTimeout(() => {
            window.location.href = "/main";
          }, 700);
          return;
        }

        loadingOverlay.classList.add("hidden");
        showError("비밀번호가 틀렸습니다.");
        busy = false;
      }

      function pressNum(n: string) {
        if (busy || pin.length >= PIN_LENGTH) return;
        pin += n;
        updateDots();
        if (navigator.vibrate) navigator.vibrate(10);
        if (pin.length === PIN_LENGTH) setTimeout(submit, 100);
      }

      function pressDelete() {
        if (busy || !pin.length) return;
        pin = pin.slice(0, -1);
        updateDots();
        if (navigator.vibrate) navigator.vibrate(5);
      }

      document.querySelectorAll<HTMLButtonElement>(".numpad-btn[data-num]").forEach((btn) =>
        btn.addEventListener("click", () => pressNum(btn.dataset.num!))
      );
      $("delete-btn").addEventListener("click", pressDelete);
      document.addEventListener("keydown", (e) => {
        if (e.key >= "0" && e.key <= "9") pressNum(e.key);
        else if (e.key === "Backspace") pressDelete();
      });
    </script>
  </body>
</html>
