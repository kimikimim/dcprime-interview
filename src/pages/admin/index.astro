---
import "../../styles/global.css";
import "../../styles/panel.css";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <title>관리자 - 대치프라임 면접반</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="admin-body">
    <!-- 헤더 -->
    <header class="admin-header">
      <div class="admin-header-inner">
        <div class="admin-header-left">
          <img src="/favicon-circle.png" alt="대치프라임" style="width:34px;height:34px;border-radius:50%;object-fit:cover" />
          <div>
            <span class="admin-title-text">DC Prime</span>
            <span class="admin-badge">관리자</span>
          </div>
        </div>
        <div class="admin-header-right">
          <button class="hamburger-btn" id="hamburgerBtn" title="메뉴">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <button class="icon-btn" id="logoutBtn" title="로그아웃">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>

      <div class="tab-bar">
        <button class="tab-btn active" data-tab="study">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          학습 현황
        </button>
        <button class="tab-btn" data-tab="authoring">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          문제출제
        </button>
        <button class="tab-btn" data-tab="students">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="19" cy="8" r="3" stroke="currentColor" stroke-width="2"/><path d="M19 5v6M16 8h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          학생 관리
        </button>
        <button class="tab-bar-logout" id="hamburgerLogoutBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          로그아웃
        </button>
      </div>
    </header>

    <!-- 학습 현황 -->
    <div class="tab-panel active" id="tabStudy">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">학습 현황</h2>
          <select class="form-input" id="studyStudentSelect" style="max-width:200px;height:36px;padding:0 10px">
            <option value="">학생 선택</option>
          </select>
        </div>
        <div id="studyContent">
          <p class="empty-text">학생을 선택하면 공통·개별 질문 답변과 모의면접 녹음을 확인할 수 있습니다.</p>
        </div>
      </div>
    </div>

    <!-- 문제출제 -->
    <div class="tab-panel" id="tabAuthoring">
      <div class="admin-panel">
        <div class="subtab-row">
          <button class="subtab-btn active" data-subtab="common">공통 질문</button>
          <button class="subtab-btn" data-subtab="individual">개별 질문</button>
          <button class="subtab-btn" data-subtab="mock">모의면접</button>
        </div>

        <!-- 공통 질문 -->
        <div class="subtab-panel active" id="subtabCommon">
          <div class="card" style="margin-bottom:16px">
            <p class="form-label">질문 내용</p>
            <textarea class="form-input" id="commonQuestionInput" rows="3" placeholder="모든 학생에게 보여줄 질문을 입력하세요" style="height:auto;padding:10px 12px;resize:vertical"></textarea>
            <button class="btn-primary-sm" id="commonQuestionSubmit" style="margin-top:10px">등록 (전체 공개)</button>
          </div>
          <div id="commonQuestionList" style="display:flex;flex-direction:column;gap:10px">
            <p class="empty-text">불러오는 중...</p>
          </div>
        </div>

        <!-- 개별 질문 -->
        <div class="subtab-panel" id="subtabIndividual">
          <div class="card" style="margin-bottom:16px">
            <p class="form-label">질문 내용 <span class="form-hint" style="display:inline;margin:0">(여러 개는 세미콜론(;)으로 구분, 번호는 자동 제거)</span></p>
            <textarea class="form-input" id="individualQuestionInput" rows="5" placeholder={"선택한 학생에게만 보여줄 질문을 입력하세요\n\n여러 개를 한 번에 등록하려면:\n1. 질문내용;\n2. 질문내용;\n3. 질문내용;"} style="height:auto;padding:10px 12px;resize:vertical;margin-bottom:12px"></textarea>
            <p class="form-label">대상 학생 (여러 명 선택 가능)</p>
            <div class="student-picker" id="individualStudentPicker">
              <p class="empty-text">학생 목록을 불러오는 중...</p>
            </div>
            <button class="btn-primary-sm" id="individualQuestionSubmit" style="margin-top:12px">등록 (선택한 학생에게만)</button>
          </div>
          <div id="individualQuestionList" style="display:flex;flex-direction:column;gap:10px">
            <p class="empty-text">불러오는 중...</p>
          </div>
        </div>

        <!-- 모의면접 -->
        <div class="subtab-panel" id="subtabMock">
          <div class="card" style="margin-bottom:16px">
            <p class="form-label">대상 학생 (여러 명 선택 가능)</p>
            <div class="student-picker" id="mockStudentPicker">
              <p class="empty-text">학생 목록을 불러오는 중...</p>
            </div>
            <button class="btn-primary-sm" id="mockAssignSubmit" style="margin-top:12px">모의면접 만들기</button>
          </div>
          <div id="mockAssignList" style="display:flex;flex-direction:column;gap:10px">
            <p class="empty-text">불러오는 중...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 학생 관리 -->
    <div class="tab-panel" id="tabStudents">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">학생 목록</h2>
          <button class="btn-primary-sm" id="addStudentBtn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="white" stroke-width="2.5" stroke-linecap="round"/></svg>
            학생 추가
          </button>
        </div>
        <div class="student-mgmt-list" id="studentMgmtList">
          <p class="empty-text">학생 데이터를 불러오는 중...</p>
        </div>
      </div>
    </div>

    <!-- 학생 추가/수정 모달 -->
    <div class="modal-overlay" id="studentModal">
      <div class="modal modal--form">
        <h3 class="modal-title" id="studentModalTitle">학생 추가</h3>

        <div class="form-group">
          <label class="form-label">이름 <span class="form-required">*</span></label>
          <input class="form-input" id="fieldName" type="text" placeholder="홍길동" maxlength="20" />
        </div>
        <div class="form-group">
          <label class="form-label">비밀번호 <span class="form-required">*</span></label>
          <input class="form-input" id="fieldPassword" type="text" placeholder="학생에게 부여할 비밀번호" maxlength="20" />
          <p class="form-hint" id="passwordHint">수정 시 비워두면 기존 비밀번호 유지</p>
        </div>
        <div class="form-group">
          <label class="form-label">지원 항목 <span class="form-hint" style="display:inline;margin:0">(작성형식: 학교명,전형,학과,면접일)</span></label>
          <textarea class="form-input" id="fieldSchool" rows="4" style="height:auto;padding:10px 12px;resize:vertical" placeholder="한 줄에 하나씩 입력하세요&#10;예) 서울대학교,지역균형,컴퓨터공학부,2026-11-28&#10;연세대학교,활동우수형,경영학과,2026-12-02"></textarea>
        </div>

        <p class="form-error" id="studentFormError"></p>

        <div class="modal-actions">
          <button class="modal-btn modal-btn--cancel" id="studentModalCancel">취소</button>
          <button class="modal-btn modal-btn--save" id="studentModalSave">저장</button>
        </div>
      </div>
    </div>

    <!-- 학생 삭제 확인 모달 -->
    <div class="modal-overlay" id="deleteStudentModal">
      <div class="modal">
        <h3 class="modal-title">학생을 삭제할까요?</h3>
        <p class="modal-desc">삭제하면 해당 학생의 로그인 정보가 함께 삭제되며 복구할 수 없습니다.</p>
        <div class="modal-actions">
          <button class="modal-btn modal-btn--cancel" id="deleteCancel">취소</button>
          <button class="modal-btn modal-btn--confirm" id="deleteConfirm">삭제</button>
        </div>
      </div>
    </div>

    <script>
      import { supabase } from "../../lib/supabase";

      const SESSION_KEY = "admin_authed";
      if (sessionStorage.getItem(SESSION_KEY) !== "ok") {
        window.location.href = "/";
      }

      type Student = {
        id: string;
        name: string;
        school: string | null;
        created_at: string;
      };

      let studentsCache: Student[] = [];

      function $<T extends HTMLElement>(id: string): T {
        return document.getElementById(id) as T;
      }
      function escapeHtml(str: string): string {
        const div = document.createElement("div");
        div.textContent = str;
        return div.innerHTML;
      }

      $("logoutBtn").addEventListener("click", () => {
        sessionStorage.removeItem(SESSION_KEY);
        window.location.href = "/";
      });

      // ── 탭 전환 + 햄버거 메뉴 ──
      const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
      const panels: Record<string, HTMLElement> = {
        study: $("tabStudy"),
        students: $("tabStudents"),
        authoring: $("tabAuthoring"),
      };
      const tabBar = document.querySelector<HTMLElement>(".tab-bar")!;
      const menuBackdrop = document.createElement("div");
      menuBackdrop.className = "menu-backdrop";
      document.body.appendChild(menuBackdrop);
      const closeMenu = () => { tabBar.classList.remove("open"); menuBackdrop.classList.remove("show"); };
      const openMenu = () => { tabBar.classList.add("open"); menuBackdrop.classList.add("show"); };

      tabBtns.forEach((b) =>
        b.addEventListener("click", () => {
          const t = b.dataset.tab!;
          tabBtns.forEach((x) => x.classList.toggle("active", x.dataset.tab === t));
          Object.entries(panels).forEach(([k, p]) => p.classList.toggle("active", k === t));
          closeMenu();
        })
      );

      $("hamburgerBtn").addEventListener("click", (e) => {
        e.stopPropagation();
        tabBar.classList.contains("open") ? closeMenu() : openMenu();
      });
      menuBackdrop.addEventListener("click", closeMenu);
      $("hamburgerLogoutBtn").addEventListener("click", () => $("logoutBtn").click());

      // ── 학생 목록 ──
      async function loadStudents() {
        const { data, error } = await supabase.rpc("admin_list_students");
        if (error) {
          console.error(error);
          return;
        }
        studentsCache = data ?? [];
        renderStudents();
      }

      function renderStudents() {
        const list = $("studentMgmtList");
        if (studentsCache.length === 0) {
          list.innerHTML = `<p class="empty-text">등록된 학생이 없습니다.</p>`;
          return;
        }
        list.innerHTML = studentsCache
          .map((s) => {
            const appLines = (s.school ?? "").split("\n").map((l) => l.trim()).filter(Boolean);
            const meta =
              appLines.length === 0
                ? "지원 항목 미입력"
                : appLines.length === 1
                ? appLines[0].split(",")[0]?.trim() ?? ""
                : `${appLines[0].split(",")[0]?.trim() ?? ""} 외 ${appLines.length - 1}건`;
            return `
              <div class="student-mgmt-card">
                <div class="student-mgmt-avatar">${escapeHtml(s.name.slice(0, 1))}</div>
                <div class="student-mgmt-info">
                  <div class="student-mgmt-name">${escapeHtml(s.name)}</div>
                  <div class="student-mgmt-meta">${escapeHtml(meta)}</div>
                </div>
                <div class="student-mgmt-actions">
                  <button class="btn-edit" data-id="${s.id}">수정</button>
                  <button class="btn-delete" data-id="${s.id}">삭제</button>
                </div>
              </div>
            `;
          })
          .join("");

        list.querySelectorAll<HTMLButtonElement>(".btn-edit").forEach((btn) =>
          btn.addEventListener("click", () => openEditModal(btn.dataset.id!))
        );
        list.querySelectorAll<HTMLButtonElement>(".btn-delete").forEach((btn) =>
          btn.addEventListener("click", () => openDeleteModal(btn.dataset.id!))
        );

        renderStudentPicker();
        renderMockStudentPicker();
        renderStudyStudentOptions();
      }

      // ── 학습 현황: 학생별 답변/모의면접 녹음 확인 ──
      function recordingsUrl(path: string): string {
        return supabase.storage.from("recordings").getPublicUrl(path).data.publicUrl;
      }

      function mockItemLabel(type: string): string {
        if (type === "intro") return "자기소개";
        if (type === "main") return "본질문";
        if (type === "followup") return "꼬리질문";
        return "마무리 질문";
      }

      function renderStudyStudentOptions() {
        const select = $<HTMLSelectElement>("studyStudentSelect");
        const prevValue = select.value;
        select.innerHTML =
          `<option value="">학생 선택</option>` +
          studentsCache.map((s) => `<option value="${s.id}">${escapeHtml(s.name)}</option>`).join("");
        if (prevValue && studentsCache.some((s) => s.id === prevValue)) {
          select.value = prevValue;
        }
        select.onchange = () => loadStudyContent(select.value);
        loadStudyContent(select.value);
      }

      async function loadStudyContent(studentId: string) {
        const container = $("studyContent");
        if (!studentId) {
          container.innerHTML = `<p class="empty-text">학생을 선택하면 공통·개별 질문 답변과 모의면접 녹음을 확인할 수 있습니다.</p>`;
          return;
        }
        container.innerHTML = `<p class="empty-text">불러오는 중...</p>`;

        const [{ data: answerRows, error: answerError }, { data: sessionRows, error: sessionError }] = await Promise.all([
          supabase
            .from("custom_answers")
            .select("answer_text, audio_path, custom_questions(question_text, visibility)")
            .eq("student_id", studentId),
          supabase
            .from("mock_sessions")
            .select("*, mock_session_items(*)")
            .eq("student_id", studentId)
            .order("started_at", { ascending: false }),
        ]);

        if (answerError) console.error(answerError);
        if (sessionError) console.error(sessionError);

        let html = `<h3 class="section-subtitle" style="margin:4px 0 10px">공통·개별 질문 답변</h3>`;
        const answered = ((answerRows ?? []) as any[]).filter((a) => a.audio_path || (a.answer_text && a.answer_text.trim()));
        if (answered.length === 0) {
          html += `<p class="empty-text">등록된 답변이 없습니다.</p>`;
        } else {
          html += answered
            .map(
              (a) => `
                <div class="card" style="margin-bottom:10px">
                  <p style="font-size:12px;color:var(--gray-3);font-weight:700;margin-bottom:6px">${a.custom_questions?.visibility === "common" ? "공통 질문" : "개별 질문"}</p>
                  <p style="font-size:14px;color:var(--black);margin-bottom:10px">${escapeHtml(a.custom_questions?.question_text ?? "")}</p>
                  ${a.audio_path ? `<audio controls src="${recordingsUrl(a.audio_path)}" style="width:100%;height:36px"></audio>` : ""}
                  ${a.answer_text ? `<p style="font-size:13px;color:var(--gray-2);margin-top:10px;white-space:pre-wrap;line-height:1.6">${escapeHtml(a.answer_text)}</p>` : ""}
                </div>
              `
            )
            .join("");
        }

        html += `<h3 class="section-subtitle" style="margin:24px 0 10px">모의면접 세션</h3>`;
        const sessions = (sessionRows ?? []) as any[];
        if (sessions.length === 0) {
          html += `<p class="empty-text">진행한 모의면접이 없습니다.</p>`;
        } else {
          html += sessions
            .map((s) => {
              const items = ((s.mock_session_items ?? []) as any[]).sort((a, b) => a.sequence_order - b.sequence_order);
              return `
                <div class="card" style="margin-bottom:14px">
                  <p style="font-size:12px;color:var(--gray-3);font-weight:700;margin-bottom:12px">
                    ${new Date(s.started_at).toLocaleString("ko-KR")} · ${s.status === "completed" ? "완료" : "진행 중"}
                  </p>
                  ${items
                    .map(
                      (it) => `
                        <div style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--gray-6)">
                          <p style="font-size:12px;color:var(--blue);font-weight:700;margin-bottom:4px">${mockItemLabel(it.item_type)}</p>
                          <p style="font-size:14px;color:var(--black);margin-bottom:8px">${escapeHtml(it.question_text)}</p>
                          ${it.audio_path ? `<audio controls src="${recordingsUrl(it.audio_path)}" style="width:100%;height:36px"></audio>` : `<p class="empty-text">녹음 없음</p>`}
                          ${it.transcript ? `<p style="font-size:13px;color:var(--gray-2);margin-top:8px;white-space:pre-wrap;line-height:1.6">받아쓰기: ${escapeHtml(it.transcript)}</p>` : ""}
                        </div>
                      `
                    )
                    .join("")}
                </div>
              `;
            })
            .join("");
        }

        container.innerHTML = html;
      }

      // ── 문제출제: 공통 질문 / 개별 질문 서브탭 ──
      const authoringSubtabBtns = document.querySelectorAll<HTMLButtonElement>("#tabAuthoring .subtab-btn");
      const authoringSubtabPanels: Record<string, HTMLElement> = {
        common: $("subtabCommon"),
        individual: $("subtabIndividual"),
        mock: $("subtabMock"),
      };
      authoringSubtabBtns.forEach((b) =>
        b.addEventListener("click", () => {
          const t = b.dataset.subtab!;
          authoringSubtabBtns.forEach((x) => x.classList.toggle("active", x.dataset.subtab === t));
          Object.entries(authoringSubtabPanels).forEach(([k, p]) => p.classList.toggle("active", k === t));
        })
      );

      // ── 문제출제: 개별 질문 대상 학생 선택 (중복 선택 가능) ──
      let selectedStudentIds = new Set<string>();

      function renderStudentPicker() {
        const picker = $("individualStudentPicker");
        if (studentsCache.length === 0) {
          picker.innerHTML = `<p class="empty-text">등록된 학생이 없습니다.</p>`;
          return;
        }
        picker.innerHTML = studentsCache
          .map(
            (s) => `
              <button type="button" class="student-toggle ${selectedStudentIds.has(s.id) ? "selected" : ""}" data-id="${s.id}">
                ${escapeHtml(s.name)}
              </button>
            `
          )
          .join("");
        picker.querySelectorAll<HTMLButtonElement>(".student-toggle").forEach((btn) =>
          btn.addEventListener("click", () => {
            const id = btn.dataset.id!;
            if (selectedStudentIds.has(id)) selectedStudentIds.delete(id);
            else selectedStudentIds.add(id);
            btn.classList.toggle("selected");
          })
        );
      }

      // ── 문제출제: 공통 질문 ──
      async function loadCommonQuestions() {
        const { data, error } = await supabase
          .from("custom_questions")
          .select("*")
          .eq("visibility", "common")
          .order("created_at", { ascending: false });
        const list = $("commonQuestionList");
        if (error) {
          list.innerHTML = `<p class="empty-text">불러오기에 실패했습니다.</p>`;
          console.error(error);
          return;
        }
        if (!data || data.length === 0) {
          list.innerHTML = `<p class="empty-text">등록된 공통 질문이 없습니다.</p>`;
          return;
        }
        list.innerHTML = data
          .map(
            (q: any) => `
              <div class="card" style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
                <p style="font-size:14px;color:var(--black);line-height:1.6">${escapeHtml(q.question_text)}</p>
                <button class="btn-delete delete-common-question" data-id="${q.id}" style="flex-shrink:0">삭제</button>
              </div>
            `
          )
          .join("");
        list.querySelectorAll<HTMLButtonElement>(".delete-common-question").forEach((btn) =>
          btn.addEventListener("click", async () => {
            await supabase.from("custom_questions").delete().eq("id", btn.dataset.id!);
            loadCommonQuestions();
          })
        );
      }

      $("commonQuestionSubmit").addEventListener("click", async () => {
        const input = $<HTMLTextAreaElement>("commonQuestionInput");
        const text = input.value.trim();
        if (!text) return;
        const { error } = await supabase.from("custom_questions").insert({ question_text: text, visibility: "common" });
        if (error) {
          alert("등록에 실패했습니다: " + error.message);
          return;
        }
        input.value = "";
        loadCommonQuestions();
      });

      // ── 문제출제: 개별 질문 ──
      async function loadIndividualQuestions() {
        const { data, error } = await supabase
          .from("custom_questions")
          .select("*, custom_question_targets(student_id)")
          .eq("visibility", "individual")
          .order("created_at", { ascending: false });
        const list = $("individualQuestionList");
        if (error) {
          list.innerHTML = `<p class="empty-text">불러오기에 실패했습니다.</p>`;
          console.error(error);
          return;
        }
        if (!data || data.length === 0) {
          list.innerHTML = `<p class="empty-text">등록된 개별 질문이 없습니다.</p>`;
          return;
        }
        list.innerHTML = data
          .map((q: any) => {
            const targetIds: string[] = (q.custom_question_targets ?? []).map((t: any) => t.student_id);
            const names = targetIds
              .map((id) => studentsCache.find((s) => s.id === id)?.name)
              .filter(Boolean)
              .join(", ") || "대상 없음";
            return `
              <div class="card">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:6px">
                  <p style="font-size:14px;color:var(--black);line-height:1.6">${escapeHtml(q.question_text)}</p>
                  <button class="btn-delete delete-individual-question" data-id="${q.id}" style="flex-shrink:0">삭제</button>
                </div>
                <p class="student-mgmt-meta">대상: ${escapeHtml(names)}</p>
              </div>
            `;
          })
          .join("");
        list.querySelectorAll<HTMLButtonElement>(".delete-individual-question").forEach((btn) =>
          btn.addEventListener("click", async () => {
            await supabase.from("custom_questions").delete().eq("id", btn.dataset.id!);
            loadIndividualQuestions();
          })
        );
      }

      // 세미콜론(;) 기준으로 여러 질문을 분리하고, 각 줄 앞의 "1. " 같은 번호를 제거
      function parseBulkQuestions(raw: string): string[] {
        return raw
          .split(";")
          .map((seg) => seg.trim().replace(/^\d+\.\s*/, "").trim())
          .filter(Boolean);
      }

      $("individualQuestionSubmit").addEventListener("click", async () => {
        const input = $<HTMLTextAreaElement>("individualQuestionInput");
        const questions = parseBulkQuestions(input.value);
        if (questions.length === 0) {
          alert("질문 내용을 입력해주세요.");
          return;
        }
        if (selectedStudentIds.size === 0) {
          alert("대상 학생을 한 명 이상 선택해주세요.");
          return;
        }

        const { data, error } = await supabase
          .from("custom_questions")
          .insert(questions.map((question_text) => ({ question_text, visibility: "individual" })))
          .select();

        if (error || !data) {
          alert("등록에 실패했습니다: " + error?.message);
          return;
        }

        const targets = data.flatMap((q: any) =>
          [...selectedStudentIds].map((student_id) => ({ custom_question_id: q.id, student_id }))
        );
        const { error: targetError } = await supabase.from("custom_question_targets").insert(targets);
        if (targetError) {
          alert("대상 학생 지정에 실패했습니다: " + targetError.message);
          return;
        }

        input.value = "";
        selectedStudentIds.clear();
        renderStudentPicker();
        loadIndividualQuestions();
      });

      // ── 문제출제: 모의면접 배정 ──
      let mockSelectedStudentIds = new Set<string>();

      function renderMockStudentPicker() {
        const picker = $("mockStudentPicker");
        if (studentsCache.length === 0) {
          picker.innerHTML = `<p class="empty-text">등록된 학생이 없습니다.</p>`;
          return;
        }
        picker.innerHTML = studentsCache
          .map(
            (s) => `
              <button type="button" class="student-toggle ${mockSelectedStudentIds.has(s.id) ? "selected" : ""}" data-id="${s.id}">
                ${escapeHtml(s.name)}
              </button>
            `
          )
          .join("");
        picker.querySelectorAll<HTMLButtonElement>(".student-toggle").forEach((btn) =>
          btn.addEventListener("click", () => {
            const id = btn.dataset.id!;
            if (mockSelectedStudentIds.has(id)) mockSelectedStudentIds.delete(id);
            else mockSelectedStudentIds.add(id);
            btn.classList.toggle("selected");
          })
        );
      }

      function mockStatusLabel(status: string): string {
        if (status === "assigned") return "배정됨 (대기 중)";
        if (status === "in_progress") return "진행 중";
        return "완료";
      }

      async function loadMockAssignments() {
        const { data, error } = await supabase
          .from("mock_sessions")
          .select("id, student_id, status, started_at")
          .order("started_at", { ascending: false });
        const list = $("mockAssignList");
        if (error) {
          list.innerHTML = `<p class="empty-text">불러오기에 실패했습니다.</p>`;
          console.error(error);
          return;
        }
        if (!data || data.length === 0) {
          list.innerHTML = `<p class="empty-text">배정된 모의면접이 없습니다.</p>`;
          return;
        }
        list.innerHTML = data
          .map((row: any) => {
            const name = studentsCache.find((s) => s.id === row.student_id)?.name ?? "알 수 없음";
            return `
              <div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                <div>
                  <p class="student-mgmt-name" style="margin-bottom:2px">${escapeHtml(name)}</p>
                  <p class="student-mgmt-meta">${mockStatusLabel(row.status)} · ${new Date(row.started_at).toLocaleString("ko-KR")}</p>
                </div>
                <button class="btn-delete delete-mock-assignment" data-id="${row.id}" style="flex-shrink:0">삭제</button>
              </div>
            `;
          })
          .join("");
        list.querySelectorAll<HTMLButtonElement>(".delete-mock-assignment").forEach((btn) =>
          btn.addEventListener("click", async () => {
            await supabase.from("mock_sessions").delete().eq("id", btn.dataset.id!);
            loadMockAssignments();
          })
        );
      }

      $("mockAssignSubmit").addEventListener("click", async () => {
        if (mockSelectedStudentIds.size === 0) {
          alert("대상 학생을 한 명 이상 선택해주세요.");
          return;
        }
        const rows = [...mockSelectedStudentIds].map((student_id) => ({
          student_id,
          planned_duration_seconds: 600 + Math.floor(Math.random() * 301),
          status: "assigned",
        }));
        const { error } = await supabase.from("mock_sessions").insert(rows);
        if (error) {
          alert("모의면접 배정에 실패했습니다: " + error.message);
          return;
        }
        mockSelectedStudentIds.clear();
        renderMockStudentPicker();
        loadMockAssignments();
      });

      // ── 추가/수정 모달 ──
      let editingId: string | null = null;

      function openAddModal() {
        editingId = null;
        $("studentModalTitle").textContent = "학생 추가";
        $<HTMLInputElement>("fieldName").value = "";
        $<HTMLInputElement>("fieldPassword").value = "";
        $<HTMLTextAreaElement>("fieldSchool").value = "";
        $("passwordHint").classList.add("hidden");
        $("studentFormError").textContent = "";
        $("studentModal").classList.add("show");
      }

      function openEditModal(id: string) {
        const s = studentsCache.find((x) => x.id === id);
        if (!s) return;
        editingId = id;
        $("studentModalTitle").textContent = "학생 수정";
        $<HTMLInputElement>("fieldName").value = s.name;
        $<HTMLInputElement>("fieldPassword").value = "";
        $<HTMLTextAreaElement>("fieldSchool").value = s.school ?? "";
        $("passwordHint").classList.remove("hidden");
        $("studentFormError").textContent = "";
        $("studentModal").classList.add("show");
      }

      function closeStudentModal() {
        $("studentModal").classList.remove("show");
      }

      $("addStudentBtn").addEventListener("click", openAddModal);
      $("studentModalCancel").addEventListener("click", closeStudentModal);

      $("studentModalSave").addEventListener("click", async () => {
        const name = $<HTMLInputElement>("fieldName").value.trim();
        const password = $<HTMLInputElement>("fieldPassword").value.trim();
        const school = $<HTMLTextAreaElement>("fieldSchool").value.trim() || null;
        const errorEl = $("studentFormError");

        if (!name) {
          errorEl.textContent = "이름을 입력해주세요.";
          return;
        }
        if (!editingId && !password) {
          errorEl.textContent = "신규 등록 시 비밀번호는 필수입니다.";
          return;
        }

        const btn = $<HTMLButtonElement>("studentModalSave");
        btn.disabled = true;

        let error;
        if (editingId) {
          ({ error } = await supabase.rpc("admin_update_student", {
            p_id: editingId,
            p_name: name,
            p_school: school,
            p_grade: null,
          }));
          if (!error && password) {
            ({ error } = await supabase.rpc("admin_set_student_password", { p_id: editingId, p_password: password }));
          }
        } else {
          ({ error } = await supabase.rpc("admin_create_student", {
            p_name: name,
            p_school: school,
            p_grade: null,
            p_password: password,
          }));
        }

        btn.disabled = false;

        if (error) {
          errorEl.textContent = "저장에 실패했습니다: " + error.message;
          return;
        }

        closeStudentModal();
        loadStudents();
      });

      // ── 삭제 모달 ──
      let deletingId: string | null = null;

      function openDeleteModal(id: string) {
        deletingId = id;
        $("deleteStudentModal").classList.add("show");
      }
      $("deleteCancel").addEventListener("click", () => $("deleteStudentModal").classList.remove("show"));
      $("deleteConfirm").addEventListener("click", async () => {
        if (!deletingId) return;
        const { error } = await supabase.rpc("admin_delete_student", { p_id: deletingId });
        $("deleteStudentModal").classList.remove("show");
        if (error) {
          alert("삭제에 실패했습니다: " + error.message);
          return;
        }
        loadStudents();
      });

      loadStudents();
      loadCommonQuestions();
      loadIndividualQuestions();
      loadMockAssignments();
    </script>
  </body>
</html>
