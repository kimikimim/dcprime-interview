---
import "../../styles/global.css";
import "../../styles/panel.css";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <title>관리자 - 대치프라임 면접반</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="admin-body">
    <!-- 헤더 -->
    <header class="admin-header">
      <div class="admin-header-inner">
        <div class="admin-header-left">
          <img src="/favicon-circle.png" alt="대치프라임" style="width:34px;height:34px;border-radius:50%;object-fit:cover" />
          <div>
            <span class="admin-title-text">DC Prime</span>
            <span class="admin-badge">관리자</span>
          </div>
        </div>
        <div class="admin-header-right">
          <button class="hamburger-btn" id="hamburgerBtn" title="메뉴">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <button class="icon-btn" id="logoutBtn" title="로그아웃">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>

      <div class="tab-bar">
        <button class="tab-btn active" data-tab="study">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          학습 현황
        </button>
        <button class="tab-btn" data-tab="authoring">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          문제출제
        </button>
        <button class="tab-btn" data-tab="students">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="19" cy="8" r="3" stroke="currentColor" stroke-width="2"/><path d="M19 5v6M16 8h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          학생 관리
        </button>
        <button class="tab-bar-logout" id="hamburgerLogoutBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          로그아웃
        </button>
      </div>
    </header>

    <!-- 학습 현황 -->
    <div class="tab-panel active" id="tabStudy">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">학습 현황</h2>
          <select class="form-input" id="studyStudentSelect" style="max-width:200px;height:36px;padding:0 10px">
            <option value="">학생 선택</option>
          </select>
        </div>
        <div id="studyContent">
          <p class="empty-text">학생을 선택하면 공통·개별 질문 답변과 모의면접 녹음을 확인할 수 있습니다.</p>
        </div>
      </div>
    </div>

    <!-- 문제출제 -->
    <div class="tab-panel" id="tabAuthoring">
      <div class="admin-panel">
        <div class="subtab-row">
          <button class="subtab-btn active" data-subtab="common">공통 질문</button>
          <button class="subtab-btn" data-subtab="individual">개별 질문</button>
          <button class="subtab-btn" data-subtab="mock">모의면접</button>
        </div>

        <!-- 공통 질문 -->
        <div class="subtab-panel active" id="subtabCommon">
          <div class="card" style="margin-bottom:16px">
            <p class="form-label">질문 내용</p>
            <textarea class="form-input" id="commonQuestionInput" rows="3" placeholder="모든 학생에게 보여줄 질문을 입력하세요" style="height:auto;padding:10px 12px;resize:vertical"></textarea>
            <button class="btn-primary-sm" id="commonQuestionSubmit" style="margin-top:10px">등록 (전체 공개)</button>
          </div>
          <div id="commonQuestionList" style="display:flex;flex-direction:column;gap:10px">
            <p class="empty-text">불러오는 중...</p>
          </div>
        </div>

        <!-- 개별 질문 -->
        <div class="subtab-panel" id="subtabIndividual">
          <div class="card" style="margin-bottom:16px">
            <p class="form-label">생기부로 질문 자동 생성 (AI)</p>
            <p class="form-hint" style="margin-bottom:10px">학생 1명을 선택하고 생기부 PDF를 업로드하면, AI가 예상 질문을 생성합니다. 검토 후 원하는 것만 등록하세요.</p>
            <select class="form-input" id="aiGenStudentSelect" style="margin-bottom:10px">
              <option value="">학생 선택</option>
            </select>
            <input type="file" accept="application/pdf" id="aiGenFileInput" class="form-input" style="margin-bottom:10px;padding:8px 12px" />
            <label class="form-label" style="display:block;margin-bottom:6px">생성할 질문 개수</label>
            <input type="number" id="aiGenCountInput" class="form-input" value="30" min="1" max="150" style="max-width:120px;margin-bottom:10px" />
            <br />
            <button class="btn-primary-sm" id="aiGenSubmitBtn">AI 질문 생성</button>
            <p class="student-mgmt-meta" id="aiGenStatus" style="margin-top:8px"></p>
          </div>

          <div id="aiGenResults" class="hidden" style="margin-bottom:16px"></div>

          <div class="card" style="margin-bottom:16px">
            <p class="form-label">질문 내용 <span class="form-hint" style="display:inline;margin:0">(여러 개는 세미콜론(;)으로 구분, 번호는 자동 제거)</span></p>
            <textarea class="form-input" id="individualQuestionInput" rows="5" placeholder={"선택한 학생에게만 보여줄 질문을 입력하세요\n\n여러 개를 한 번에 등록하려면:\n1. 질문내용;\n2. 질문내용;\n3. 질문내용;"} style="height:auto;padding:10px 12px;resize:vertical;margin-bottom:12px"></textarea>
            <p class="form-label">대상 학생 (여러 명 선택 가능)</p>
            <div class="student-picker" id="individualStudentPicker">
              <p class="empty-text">학생 목록을 불러오는 중...</p>
            </div>
            <button class="btn-primary-sm" id="individualQuestionSubmit" style="margin-top:12px">등록 (선택한 학생에게만)</button>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;flex-wrap:wrap">
            <p class="student-mgmt-meta" id="individualQuestionCount"></p>
            <select class="form-input" id="individualFilterSelect" style="max-width:200px;height:36px;padding:0 10px">
              <option value="">전체 학생</option>
            </select>
          </div>
          <div id="individualQuestionList" style="display:flex;flex-direction:column;gap:10px">
            <p class="empty-text">불러오는 중...</p>
          </div>
        </div>

        <!-- 모의면접 -->
        <div class="subtab-panel" id="subtabMock">
          <div class="card" style="margin-bottom:16px">
            <p class="form-label">대상 학생 (여러 명 선택 가능)</p>
            <div class="student-picker" id="mockStudentPicker">
              <p class="empty-text">학생 목록을 불러오는 중...</p>
            </div>
            <label style="display:flex;align-items:center;gap:8px;margin-top:14px;font-size:13px;color:var(--black);cursor:pointer">
              <input type="checkbox" id="mockFollowupToggle" checked />
              꼬리질문 포함 (AI가 답변을 듣고 실시간으로 생성)
            </label>
            <button class="btn-primary-sm" id="mockAssignSubmit" style="margin-top:12px">모의면접 만들기</button>
          </div>
          <div id="mockAssignList" style="display:flex;flex-direction:column;gap:10px">
            <p class="empty-text">불러오는 중...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 학생 관리 -->
    <div class="tab-panel" id="tabStudents">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">학생 목록</h2>
          <button class="btn-primary-sm" id="addStudentBtn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="white" stroke-width="2.5" stroke-linecap="round"/></svg>
            학생 추가
          </button>
        </div>
        <div class="student-mgmt-list" id="studentMgmtList">
          <p class="empty-text">학생 데이터를 불러오는 중...</p>
        </div>
      </div>
    </div>

    <!-- 학생 추가/수정 모달 -->
    <div class="modal-overlay" id="studentModal">
      <div class="modal modal--form">
        <h3 class="modal-title" id="studentModalTitle">학생 추가</h3>

        <div class="form-group">
          <label class="form-label">이름 <span class="form-required">*</span></label>
          <input class="form-input" id="fieldName" type="text" placeholder="홍길동" maxlength="20" />
        </div>
        <div class="form-group">
          <label class="form-label">비밀번호 <span class="form-required">*</span></label>
          <input class="form-input" id="fieldPassword" type="text" inputmode="numeric" placeholder="숫자 4자리 (학생 로그인용)" maxlength="4" autocomplete="off" />
          <p class="form-hint" id="passwordHint">수정 시 비워두면 기존 비밀번호 유지</p>
        </div>
        <div class="form-group">
          <label class="form-label">지원 항목 <span class="form-hint" style="display:inline;margin:0">(작성형식: 학교명,전형,학과,면접일)</span></label>
          <textarea class="form-input" id="fieldSchool" rows="4" style="height:auto;padding:10px 12px;resize:vertical" placeholder="한 줄에 하나씩 입력하세요&#10;예) 서울대학교,지역균형,컴퓨터공학부,2026-11-28&#10;연세대학교,활동우수형,경영학과,2026-12-02"></textarea>
        </div>

        <p class="form-error" id="studentFormError"></p>

        <div class="modal-actions">
          <button class="modal-btn modal-btn--cancel" id="studentModalCancel">취소</button>
          <button class="modal-btn modal-btn--save" id="studentModalSave">저장</button>
        </div>
      </div>
    </div>

    <!-- 학생 삭제 확인 모달 -->
    <div class="modal-overlay" id="deleteStudentModal">
      <div class="modal">
        <h3 class="modal-title">학생을 삭제할까요?</h3>
        <p class="modal-desc">삭제하면 로그인 정보와 함께 이 학생의 답변, 음성 녹음, 모의면접 기록이 모두 삭제되며 복구할 수 없습니다.</p>
        <div class="modal-actions">
          <button class="modal-btn modal-btn--cancel" id="deleteCancel">취소</button>
          <button class="modal-btn modal-btn--confirm" id="deleteConfirm">삭제</button>
        </div>
      </div>
    </div>

    <script>
      import { supabase, supabaseUrl, supabaseAnonKey } from "../../lib/supabase";

      const SESSION_KEY = "admin_authed";
      if (sessionStorage.getItem(SESSION_KEY) !== "ok") {
        window.location.href = "/";
      }

      type Student = {
        id: string;
        name: string;
        school: string | null;
        created_at: string;
      };

      let studentsCache: Student[] = [];

      function $<T extends HTMLElement>(id: string): T {
        return document.getElementById(id) as T;
      }
      function escapeHtml(str: string): string {
        const div = document.createElement("div");
        div.textContent = str;
        return div.innerHTML;
      }

      // Supabase API는 한 번에 최대 1000행만 돌려주므로, 그 이상은 나눠서 전부 가져옴
      async function fetchAllRows<T = any>(
        build: (from: number, to: number) => PromiseLike<{ data: T[] | null; error: any }>
      ): Promise<T[]> {
        const PAGE = 1000;
        const rows: T[] = [];
        for (let from = 0; ; from += PAGE) {
          const { data, error } = await build(from, from + PAGE - 1);
          if (error) throw error;
          rows.push(...(data ?? []));
          if (!data || data.length < PAGE) break;
        }
        return rows;
      }

      // 삭제된 질문/학생/세션에 딸린 녹음 파일이 저장소에 계속 남지 않도록 정리 (실패해도 화면 동작에는 영향 없음)
      async function removeRecordings(paths: (string | null | undefined)[]) {
        const list = paths.filter((p): p is string => !!p);
        for (let i = 0; i < list.length; i += 100) {
          const { error } = await supabase.storage.from("recordings").remove(list.slice(i, i + 100));
          if (error) console.error("녹음 파일 삭제 실패:", error);
        }
      }

      $("logoutBtn").addEventListener("click", () => {
        sessionStorage.removeItem(SESSION_KEY);
        window.location.href = "/";
      });

      // ── 탭 전환 + 햄버거 메뉴 ──
      const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
      const panels: Record<string, HTMLElement> = {
        study: $("tabStudy"),
        students: $("tabStudents"),
        authoring: $("tabAuthoring"),
      };
      const tabBar = document.querySelector<HTMLElement>(".tab-bar")!;
      const menuBackdrop = document.createElement("div");
      menuBackdrop.className = "menu-backdrop";
      document.body.appendChild(menuBackdrop);
      const closeMenu = () => { tabBar.classList.remove("open"); menuBackdrop.classList.remove("show"); };
      const openMenu = () => { tabBar.classList.add("open"); menuBackdrop.classList.add("show"); };

      tabBtns.forEach((b) =>
        b.addEventListener("click", () => {
          const t = b.dataset.tab!;
          tabBtns.forEach((x) => x.classList.toggle("active", x.dataset.tab === t));
          Object.entries(panels).forEach(([k, p]) => p.classList.toggle("active", k === t));
          closeMenu();
        })
      );

      $("hamburgerBtn").addEventListener("click", (e) => {
        e.stopPropagation();
        tabBar.classList.contains("open") ? closeMenu() : openMenu();
      });
      menuBackdrop.addEventListener("click", closeMenu);
      $("hamburgerLogoutBtn").addEventListener("click", () => $("logoutBtn").click());

      // ── 학생 목록 ──
      async function loadStudents() {
        const { data, error } = await supabase.rpc("admin_list_students");
        if (error) {
          console.error(error);
          return;
        }
        studentsCache = data ?? [];
        renderStudents();
        // 이 목록들은 학생 이름을 studentsCache에서 찾아 표시하므로, 학생 정보가 준비된 뒤(그리고 학생이
        // 추가/수정/삭제될 때마다) 다시 그려야 "알 수 없음"/"대상 없음"으로 잘못 나오지 않음
        loadIndividualQuestions();
        loadMockAssignments();
      }

      type StudentProgressStats = {
        commonTotal: number;
        individualTotalByStudent: Map<string, number>;
        commonAnsweredByStudent: Map<string, number>;
        individualAnsweredByStudent: Map<string, number>;
      };

      async function loadStudentProgressStats(): Promise<StudentProgressStats> {
        const [{ count: commonTotal }, targetRows, answerRows] = await Promise.all([
          supabase.from("custom_questions").select("id", { count: "exact", head: true }).eq("visibility", "common"),
          fetchAllRows((from, to) =>
            supabase.from("custom_question_targets").select("student_id").order("custom_question_id").order("student_id").range(from, to)
          ).catch((e) => { console.error(e); return []; }),
          fetchAllRows((from, to) =>
            supabase.from("custom_answers").select("student_id, answer_text, audio_path, custom_questions(visibility)").order("id").range(from, to)
          ).catch((e) => { console.error(e); return []; }),
        ]);

        const individualTotalByStudent = new Map<string, number>();
        ((targetRows ?? []) as any[]).forEach((r) => {
          individualTotalByStudent.set(r.student_id, (individualTotalByStudent.get(r.student_id) ?? 0) + 1);
        });

        const commonAnsweredByStudent = new Map<string, number>();
        const individualAnsweredByStudent = new Map<string, number>();
        ((answerRows ?? []) as any[]).forEach((a) => {
          const isAnswered = a.audio_path || (a.answer_text && a.answer_text.trim());
          if (!isAnswered) return;
          const visibility = a.custom_questions?.visibility;
          const map = visibility === "common" ? commonAnsweredByStudent : visibility === "individual" ? individualAnsweredByStudent : null;
          if (map) map.set(a.student_id, (map.get(a.student_id) ?? 0) + 1);
        });

        return { commonTotal: commonTotal ?? 0, individualTotalByStudent, commonAnsweredByStudent, individualAnsweredByStudent };
      }

      async function renderStudents() {
        const list = $("studentMgmtList");
        if (studentsCache.length === 0) {
          list.innerHTML = `<p class="empty-text">등록된 학생이 없습니다.</p>`;
          return;
        }

        const stats = await loadStudentProgressStats();

        list.innerHTML = studentsCache
          .map((s) => {
            const appLines = (s.school ?? "").split("\n").map((l) => l.trim()).filter(Boolean);
            const meta =
              appLines.length === 0
                ? "지원 항목 미입력"
                : appLines.length === 1
                ? appLines[0].split(",")[0]?.trim() ?? ""
                : `${appLines[0].split(",")[0]?.trim() ?? ""} 외 ${appLines.length - 1}건`;
            const commonDone = stats.commonAnsweredByStudent.get(s.id) ?? 0;
            const individualTotal = stats.individualTotalByStudent.get(s.id) ?? 0;
            const individualDone = stats.individualAnsweredByStudent.get(s.id) ?? 0;
            const progressMeta = `공통 ${commonDone}/${stats.commonTotal} · 개별 ${individualDone}/${individualTotal}`;
            return `
              <div class="student-mgmt-card">
                <div class="student-mgmt-avatar">${escapeHtml(s.name.slice(0, 1))}</div>
                <div class="student-mgmt-info">
                  <div class="student-mgmt-name">${escapeHtml(s.name)}</div>
                  <div class="student-mgmt-meta">${escapeHtml(meta)}</div>
                  <div class="student-mgmt-meta" style="margin-top:2px">${escapeHtml(progressMeta)}</div>
                </div>
                <div class="student-mgmt-actions">
                  <button class="btn-edit" data-id="${s.id}">수정</button>
                  <button class="btn-delete" data-id="${s.id}">삭제</button>
                </div>
              </div>
            `;
          })
          .join("");

        list.querySelectorAll<HTMLButtonElement>(".btn-edit").forEach((btn) =>
          btn.addEventListener("click", () => openEditModal(btn.dataset.id!))
        );
        list.querySelectorAll<HTMLButtonElement>(".btn-delete").forEach((btn) =>
          btn.addEventListener("click", () => openDeleteModal(btn.dataset.id!))
        );

        renderStudentPicker();
        renderMockStudentPicker();
        renderStudyStudentOptions();
        renderAiGenStudentOptions();
        renderIndividualFilterOptions();
      }

      // ── 학습 현황: 학생별 답변/모의면접 녹음 확인 ──
      function recordingsUrl(path: string): string {
        return supabase.storage.from("recordings").getPublicUrl(path).data.publicUrl;
      }

      function mockItemLabel(type: string): string {
        if (type === "intro") return "자기소개";
        if (type === "main") return "본질문";
        if (type === "followup") return "꼬리질문";
        return "마무리 질문";
      }

      function renderStudyStudentOptions() {
        const select = $<HTMLSelectElement>("studyStudentSelect");
        const prevValue = select.value;
        select.innerHTML =
          `<option value="">학생 선택</option>` +
          studentsCache.map((s) => `<option value="${s.id}">${escapeHtml(s.name)}</option>`).join("");
        if (prevValue && studentsCache.some((s) => s.id === prevValue)) {
          select.value = prevValue;
        }
        select.onchange = () => loadStudyContent(select.value);
        loadStudyContent(select.value);
      }

      let studyRequestSeq = 0;

      async function loadStudyContent(studentId: string) {
        const container = $("studyContent");
        // 학생을 빠르게 바꿨을 때 늦게 도착한 이전 학생의 응답이 화면을 덮어쓰지 않도록 요청 번호로 구분
        const mySeq = ++studyRequestSeq;
        if (!studentId) {
          container.innerHTML = `<p class="empty-text">학생을 선택하면 공통·개별 질문 답변과 모의면접 녹음을 확인할 수 있습니다.</p>`;
          return;
        }
        container.innerHTML = `<p class="empty-text">불러오는 중...</p>`;

        const [
          { data: answerRows, error: answerError },
          { data: sessionRows, error: sessionError },
          { count: commonTotal },
          { count: individualTotal },
        ] = await Promise.all([
          supabase
            .from("custom_answers")
            .select("answer_text, audio_path, custom_questions(question_text, visibility)")
            .eq("student_id", studentId),
          supabase
            .from("mock_sessions")
            .select("*, mock_session_items(*)")
            .eq("student_id", studentId)
            .order("started_at", { ascending: false }),
          supabase.from("custom_questions").select("id", { count: "exact", head: true }).eq("visibility", "common"),
          supabase.from("custom_question_targets").select("student_id", { count: "exact", head: true }).eq("student_id", studentId),
        ]);

        if (mySeq !== studyRequestSeq) return;
        if (answerError) console.error(answerError);
        if (sessionError) console.error(sessionError);

        const answered = ((answerRows ?? []) as any[]).filter((a) => a.audio_path || (a.answer_text && a.answer_text.trim()));
        const commonAnswered = answered.filter((a) => a.custom_questions?.visibility === "common").length;
        const individualAnswered = answered.filter((a) => a.custom_questions?.visibility === "individual").length;
        const commonPct = commonTotal ? Math.round((commonAnswered / commonTotal) * 100) : 0;
        const individualPct = individualTotal ? Math.round((individualAnswered / individualTotal) * 100) : 0;

        function progressBar(label: string, done: number, total: number, pct: number): string {
          return `
            <div style="margin-bottom:14px">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                <span style="font-size:13px;font-weight:700;color:var(--black)">${label}</span>
                <span style="font-size:13px;color:var(--gray-3)">${done}/${total} (${pct}%)</span>
              </div>
              <div style="height:8px;background:var(--gray-7);border-radius:4px;overflow:hidden">
                <div style="height:100%;width:${pct}%;background:var(--blue)"></div>
              </div>
            </div>
          `;
        }

        let html = `
          <div class="card" style="margin-bottom:16px">
            ${progressBar("공통 질문", commonAnswered, commonTotal ?? 0, commonPct)}
            ${progressBar("개별 질문", individualAnswered, individualTotal ?? 0, individualPct)}
          </div>
        `;

        html += `<h3 class="section-subtitle" style="margin:4px 0 10px">공통·개별 질문 답변</h3>`;
        if (answered.length === 0) {
          html += `<p class="empty-text">등록된 답변이 없습니다.</p>`;
        } else {
          html += answered
            .map(
              (a) => `
                <div class="card" style="margin-bottom:10px">
                  <p style="font-size:12px;color:var(--gray-3);font-weight:700;margin-bottom:6px">${a.custom_questions?.visibility === "common" ? "공통 질문" : "개별 질문"}</p>
                  <p style="font-size:14px;color:var(--black);margin-bottom:10px">${escapeHtml(a.custom_questions?.question_text ?? "")}</p>
                  ${a.audio_path ? `<audio controls preload="none" src="${recordingsUrl(a.audio_path)}" style="width:100%;height:36px"></audio>` : ""}
                  ${a.answer_text ? `<p style="font-size:13px;color:var(--gray-2);margin-top:10px;white-space:pre-wrap;line-height:1.6">${escapeHtml(a.answer_text)}</p>` : ""}
                </div>
              `
            )
            .join("");
        }

        html += `<h3 class="section-subtitle" style="margin:24px 0 10px">모의면접 세션</h3>`;
        const sessions = (sessionRows ?? []) as any[];
        // 학생 화면의 "모의면접 N회차"와 같은 번호가 되도록 완료된 세션을 시작 시각 순으로 번호 매김
        const roundById = new Map<string, number>();
        sessions
          .filter((s) => s.status === "completed")
          .sort((a, b) => (a.started_at < b.started_at ? -1 : 1))
          .forEach((s, i) => roundById.set(s.id, i + 1));
        const statusText = (s: any) =>
          s.status === "completed" ? `모의면접 ${roundById.get(s.id)}회차 · 완료` : s.status === "assigned" ? "배정됨 (아직 시작 전)" : "진행 중";
        if (sessions.length === 0) {
          html += `<p class="empty-text">진행한 모의면접이 없습니다.</p>`;
        } else {
          html += sessions
            .map((s) => {
              const items = ((s.mock_session_items ?? []) as any[]).sort((a, b) => a.sequence_order - b.sequence_order);
              return `
                <div class="card" style="margin-bottom:14px">
                  <p style="font-size:12px;color:var(--gray-3);font-weight:700;margin-bottom:12px">
                    ${statusText(s)} · ${new Date(s.started_at).toLocaleString("ko-KR")}
                  </p>
                  ${items
                    .map(
                      (it) => `
                        <div style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--gray-6)">
                          <p style="font-size:12px;color:var(--blue);font-weight:700;margin-bottom:4px">${mockItemLabel(it.item_type)}</p>
                          <p style="font-size:14px;color:var(--black);margin-bottom:8px">${escapeHtml(it.question_text)}</p>
                          ${it.audio_path ? `<audio controls preload="none" src="${recordingsUrl(it.audio_path)}" style="width:100%;height:36px"></audio>` : `<p class="empty-text">녹음 없음</p>`}
                          ${it.transcript ? `<p style="font-size:13px;color:var(--gray-2);margin-top:8px;white-space:pre-wrap;line-height:1.6">받아쓰기: ${escapeHtml(it.transcript)}</p>` : ""}
                        </div>
                      `
                    )
                    .join("")}
                </div>
              `;
            })
            .join("");
        }

        container.innerHTML = html;
      }

      // ── 문제출제: 공통 질문 / 개별 질문 서브탭 ──
      const authoringSubtabBtns = document.querySelectorAll<HTMLButtonElement>("#tabAuthoring .subtab-btn");
      const authoringSubtabPanels: Record<string, HTMLElement> = {
        common: $("subtabCommon"),
        individual: $("subtabIndividual"),
        mock: $("subtabMock"),
      };
      authoringSubtabBtns.forEach((b) =>
        b.addEventListener("click", () => {
          const t = b.dataset.subtab!;
          authoringSubtabBtns.forEach((x) => x.classList.toggle("active", x.dataset.subtab === t));
          Object.entries(authoringSubtabPanels).forEach(([k, p]) => p.classList.toggle("active", k === t));
        })
      );

      // ── 문제출제: 개별 질문 대상 학생 선택 (중복 선택 가능) ──
      let selectedStudentIds = new Set<string>();

      function renderStudentPicker() {
        const picker = $("individualStudentPicker");
        if (studentsCache.length === 0) {
          picker.innerHTML = `<p class="empty-text">등록된 학생이 없습니다.</p>`;
          return;
        }
        picker.innerHTML = studentsCache
          .map(
            (s) => `
              <button type="button" class="student-toggle ${selectedStudentIds.has(s.id) ? "selected" : ""}" data-id="${s.id}">
                ${escapeHtml(s.name)}
              </button>
            `
          )
          .join("");
        picker.querySelectorAll<HTMLButtonElement>(".student-toggle").forEach((btn) =>
          btn.addEventListener("click", () => {
            const id = btn.dataset.id!;
            if (selectedStudentIds.has(id)) selectedStudentIds.delete(id);
            else selectedStudentIds.add(id);
            btn.classList.toggle("selected");
          })
        );
      }

      // ── 문제출제: 공통 질문 ──
      async function loadCommonQuestions() {
        const { data, error } = await supabase
          .from("custom_questions")
          .select("*")
          .eq("visibility", "common")
          .order("created_at", { ascending: true });
        const list = $("commonQuestionList");
        if (error) {
          list.innerHTML = `<p class="empty-text">불러오기에 실패했습니다.</p>`;
          console.error(error);
          return;
        }
        if (!data || data.length === 0) {
          list.innerHTML = `<p class="empty-text">등록된 공통 질문이 없습니다.</p>`;
          return;
        }
        list.innerHTML = data
          .map(
            (q: any) => `
              <div class="card" style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
                <p style="font-size:14px;color:var(--black);line-height:1.6">${escapeHtml(q.question_text)}</p>
                <button class="btn-delete delete-common-question" data-id="${q.id}" style="flex-shrink:0">삭제</button>
              </div>
            `
          )
          .join("");
        list.querySelectorAll<HTMLButtonElement>(".delete-common-question").forEach((btn) =>
          btn.addEventListener("click", async () => {
            if (await deleteCustomQuestion(btn.dataset.id!)) loadCommonQuestions();
          })
        );
      }

      // 질문을 지우면 학생들이 쓴 답변/녹음도 함께 사라지므로, 몇 건이 지워지는지 알려주고 확인받음
      async function deleteCustomQuestion(id: string): Promise<boolean> {
        const { data: answers } = await supabase.from("custom_answers").select("answer_text, audio_path").eq("custom_question_id", id);
        const filled = ((answers ?? []) as any[]).filter((a) => a.audio_path || (a.answer_text && a.answer_text.trim()));
        const warning = filled.length
          ? `이 질문을 삭제할까요?\n\n학생들이 작성한 답변 ${filled.length}건(텍스트/녹음)도 함께 삭제되며 복구할 수 없습니다.`
          : "이 질문을 삭제할까요?";
        if (!confirm(warning)) return false;
        const { error } = await supabase.from("custom_questions").delete().eq("id", id);
        if (error) {
          alert("삭제에 실패했습니다: " + error.message);
          return false;
        }
        await removeRecordings(filled.map((a) => a.audio_path));
        return true;
      }

      $("commonQuestionSubmit").addEventListener("click", async () => {
        const input = $<HTMLTextAreaElement>("commonQuestionInput");
        const text = input.value.trim();
        if (!text) return;
        const { error } = await supabase.from("custom_questions").insert({ question_text: text, visibility: "common" });
        if (error) {
          alert("등록에 실패했습니다: " + error.message);
          return;
        }
        input.value = "";
        loadCommonQuestions();
      });

      // ── 문제출제: 생기부 기반 AI 질문 생성 ──
      type AiGenQuestion = { category: string; source: string; question: string };
      let aiGenQuestions: AiGenQuestion[] = [];
      let aiGenTargetStudentId = "";
      let aiGenTargetStudentName = "";

      function renderAiGenStudentOptions() {
        const select = $<HTMLSelectElement>("aiGenStudentSelect");
        const prevValue = select.value;
        select.innerHTML =
          `<option value="">학생 선택</option>` +
          studentsCache.map((s) => `<option value="${s.id}">${escapeHtml(s.name)}</option>`).join("");
        if (prevValue && studentsCache.some((s) => s.id === prevValue)) {
          select.value = prevValue;
        }
      }

      function fileToBase64(file: File): Promise<string> {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onloadend = () => resolve((reader.result as string).split(",")[1] ?? "");
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      }

      function renderAiGenResults() {
        const container = $("aiGenResults");
        if (aiGenQuestions.length === 0) {
          container.classList.add("hidden");
          container.innerHTML = "";
          return;
        }

        const groups = new Map<string, { q: AiGenQuestion; index: number }[]>();
        aiGenQuestions.forEach((q, index) => {
          if (!groups.has(q.category)) groups.set(q.category, []);
          groups.get(q.category)!.push({ q, index });
        });

        let html = "";
        groups.forEach((items, category) => {
          html += `
            <div class="card" style="margin-bottom:12px">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                <p class="form-label" style="margin:0">${escapeHtml(category)} (${items.length})</p>
                <button type="button" class="ai-select-all" data-category="${escapeHtml(category)}"
                  style="background:none;border:none;padding:0;font-size:12px;font-weight:700;color:var(--blue);cursor:pointer">전체 선택</button>
              </div>
              ${items
                .map(
                  ({ q, index }) => `
                    <label style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;font-size:13px;line-height:1.5;cursor:pointer">
                      <input type="checkbox" class="ai-question-checkbox" data-index="${index}" style="margin-top:3px" />
                      <span>${escapeHtml(q.question)}<br/><span style="color:var(--gray-3);font-size:11px">${escapeHtml(q.source)}</span></span>
                    </label>
                  `
                )
                .join("")}
            </div>
          `;
        });
        html += `<button class="btn-primary-sm" id="aiGenRegisterBtn" style="margin-bottom:16px">선택한 질문을 ${escapeHtml(aiGenTargetStudentName)} 학생에게 등록</button>`;

        container.innerHTML = html;
        container.classList.remove("hidden");

        container.querySelectorAll<HTMLButtonElement>(".ai-select-all").forEach((btn) =>
          btn.addEventListener("click", () => {
            const category = btn.dataset.category!;
            container.querySelectorAll<HTMLInputElement>(".ai-question-checkbox").forEach((cb) => {
              const idx = Number(cb.dataset.index);
              if (aiGenQuestions[idx]?.category === category) cb.checked = true;
            });
          })
        );

        $("aiGenRegisterBtn").addEventListener("click", registerSelectedAiQuestions);
      }

      $("aiGenSubmitBtn").addEventListener("click", async () => {
        const studentId = $<HTMLSelectElement>("aiGenStudentSelect").value;
        const fileInput = $<HTMLInputElement>("aiGenFileInput");
        const file = fileInput.files?.[0];
        const statusEl = $("aiGenStatus");
        const btn = $<HTMLButtonElement>("aiGenSubmitBtn");

        if (!studentId) {
          alert("학생을 선택해주세요.");
          return;
        }
        if (!file) {
          alert("생기부 PDF 파일을 선택해주세요.");
          return;
        }
        // Gemini 요청 한도(20MB)에서 base64 변환(약 1.33배)을 감안한 상한
        if (file.size > 14 * 1024 * 1024) {
          alert("PDF 용량이 너무 큽니다 (14MB 이하만 가능). 스캔 해상도를 낮추거나 용량을 줄여 다시 올려주세요.");
          return;
        }
        const countInput = $<HTMLInputElement>("aiGenCountInput");
        const count = Math.min(150, Math.max(1, Math.round(Number(countInput.value)) || 30));
        countInput.value = String(count);

        btn.disabled = true;
        statusEl.textContent = `AI가 생기부를 분석하고 있습니다... (질문 ${count}개, 1~2분 정도 걸릴 수 있어요)`;

        try {
          const pdfBase64 = await fileToBase64(file);
          const res = await fetch(`${supabaseUrl}/functions/v1/generate-questions-from-record`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${supabaseAnonKey}`,
              apikey: supabaseAnonKey,
            },
            body: JSON.stringify({ pdfBase64, count }),
          });

          if (!res.ok) {
            const errText = await res.text();
            throw new Error(errText);
          }

          const json = await res.json();
          aiGenQuestions = json.questions ?? [];
          aiGenTargetStudentId = studentId;
          aiGenTargetStudentName = studentsCache.find((s) => s.id === studentId)?.name ?? "";
          statusEl.textContent = `${aiGenQuestions.length}개 질문이 생성되었습니다. ${aiGenTargetStudentName} 학생에게 등록할 질문을 골라주세요.`;
          renderAiGenResults();
        } catch (err) {
          console.error(err);
          statusEl.textContent = "질문 생성에 실패했습니다.";
        } finally {
          btn.disabled = false;
        }
      });

      async function registerSelectedAiQuestions() {
        // 생성할 때 골라둔 학생에게만 등록 (그 사이 드롭다운을 바꿔도 다른 학생에게 잘못 들어가지 않음)
        const studentId = aiGenTargetStudentId;
        const checked = document.querySelectorAll<HTMLInputElement>(".ai-question-checkbox:checked");
        if (!studentId) {
          alert("생성된 질문이 없습니다. 먼저 질문을 생성해주세요.");
          return;
        }
        if (checked.length === 0) {
          alert("등록할 질문을 한 개 이상 선택해주세요.");
          return;
        }

        const registerBtn = $<HTMLButtonElement>("aiGenRegisterBtn");
        registerBtn.disabled = true;

        const indexes = [...checked].map((cb) => Number(cb.dataset.index));
        const selected = indexes.map((i) => aiGenQuestions[i]);
        const { data, error } = await supabase
          .from("custom_questions")
          .insert(selected.map((q) => ({ question_text: q.question, visibility: "individual" })))
          .select();

        if (error || !data) {
          registerBtn.disabled = false;
          alert("등록에 실패했습니다: " + error?.message);
          return;
        }

        const targets = data.map((q: any) => ({ custom_question_id: q.id, student_id: studentId }));
        const { error: targetError } = await supabase.from("custom_question_targets").insert(targets);
        if (targetError) {
          // 대상 지정에 실패하면 아무에게도 안 보이는 질문이 남으므로 방금 만든 질문을 되돌림
          await supabase.from("custom_questions").delete().in("id", data.map((q: any) => q.id));
          registerBtn.disabled = false;
          alert("대상 학생 지정에 실패했습니다. 등록을 취소했으니 다시 시도해주세요: " + targetError.message);
          return;
        }

        // 등록한 것만 목록에서 빼고, 아직 안 고른 질문은 남겨둠 (다시 생성하면 AI 비용이 또 듦)
        const registered = new Set(indexes);
        aiGenQuestions = aiGenQuestions.filter((_, i) => !registered.has(i));
        renderAiGenResults();
        if (aiGenQuestions.length === 0) $<HTMLInputElement>("aiGenFileInput").value = "";
        $("aiGenStatus").textContent =
          `${selected.length}개 질문을 ${aiGenTargetStudentName} 학생에게 등록했습니다.` +
          (aiGenQuestions.length ? ` 남은 ${aiGenQuestions.length}개는 아래에서 계속 고를 수 있어요.` : "");
        loadIndividualQuestions();
      }

      // ── 문제출제: 개별 질문 ──
      function renderIndividualFilterOptions() {
        const select = $<HTMLSelectElement>("individualFilterSelect");
        const prevValue = select.value;
        select.innerHTML =
          `<option value="">전체 학생</option>` +
          studentsCache.map((s) => `<option value="${s.id}">${escapeHtml(s.name)}</option>`).join("");
        if (prevValue && studentsCache.some((s) => s.id === prevValue)) select.value = prevValue;
        select.onchange = () => loadIndividualQuestions();
      }

      async function loadIndividualQuestions() {
        const list = $("individualQuestionList");
        let allRows: any[];
        try {
          allRows = await fetchAllRows((from, to) =>
            supabase
              .from("custom_questions")
              .select("*, custom_question_targets(student_id)")
              .eq("visibility", "individual")
              .order("created_at", { ascending: true })
              .order("id")
              .range(from, to)
          );
        } catch (error) {
          list.innerHTML = `<p class="empty-text">불러오기에 실패했습니다.</p>`;
          console.error(error);
          return;
        }
        const filterId = $<HTMLSelectElement>("individualFilterSelect").value;
        const data = filterId
          ? allRows.filter((q) => (q.custom_question_targets ?? []).some((t: any) => t.student_id === filterId))
          : allRows;
        $("individualQuestionCount").textContent = `총 ${data.length}개`;
        if (data.length === 0) {
          list.innerHTML = `<p class="empty-text">등록된 개별 질문이 없습니다.</p>`;
          return;
        }
        list.innerHTML = data
          .map((q: any) => {
            const targetIds: string[] = (q.custom_question_targets ?? []).map((t: any) => t.student_id);
            const names = targetIds
              .map((id) => studentsCache.find((s) => s.id === id)?.name)
              .filter(Boolean)
              .join(", ") || "대상 없음";
            return `
              <div class="card">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:6px">
                  <p style="font-size:14px;color:var(--black);line-height:1.6">${escapeHtml(q.question_text)}</p>
                  <button class="btn-delete delete-individual-question" data-id="${q.id}" style="flex-shrink:0">삭제</button>
                </div>
                <p class="student-mgmt-meta">대상: ${escapeHtml(names)}</p>
              </div>
            `;
          })
          .join("");
        list.querySelectorAll<HTMLButtonElement>(".delete-individual-question").forEach((btn) =>
          btn.addEventListener("click", async () => {
            if (await deleteCustomQuestion(btn.dataset.id!)) loadIndividualQuestions();
          })
        );
      }

      // 세미콜론(;) 기준으로 여러 질문을 분리하고, 각 줄 앞의 "1. " 같은 번호를 제거
      function parseBulkQuestions(raw: string): string[] {
        return raw
          .split(";")
          .map((seg) => seg.trim().replace(/^\d+\.\s*/, "").trim())
          .filter(Boolean);
      }

      $("individualQuestionSubmit").addEventListener("click", async () => {
        const input = $<HTMLTextAreaElement>("individualQuestionInput");
        const questions = parseBulkQuestions(input.value);
        if (questions.length === 0) {
          alert("질문 내용을 입력해주세요.");
          return;
        }
        if (selectedStudentIds.size === 0) {
          alert("대상 학생을 한 명 이상 선택해주세요.");
          return;
        }

        const { data, error } = await supabase
          .from("custom_questions")
          .insert(questions.map((question_text) => ({ question_text, visibility: "individual" })))
          .select();

        if (error || !data) {
          alert("등록에 실패했습니다: " + error?.message);
          return;
        }

        const targets = data.flatMap((q: any) =>
          [...selectedStudentIds].map((student_id) => ({ custom_question_id: q.id, student_id }))
        );
        const { error: targetError } = await supabase.from("custom_question_targets").insert(targets);
        if (targetError) {
          // 대상 없이 남은 질문이 생기지 않도록 방금 만든 질문을 되돌림 (입력한 내용은 그대로 두어 다시 시도 가능)
          await supabase.from("custom_questions").delete().in("id", data.map((q: any) => q.id));
          alert("대상 학생 지정에 실패했습니다. 등록을 취소했으니 다시 시도해주세요: " + targetError.message);
          return;
        }

        input.value = "";
        selectedStudentIds.clear();
        renderStudentPicker();
        loadIndividualQuestions();
      });

      // ── 문제출제: 모의면접 배정 ──
      let mockSelectedStudentIds = new Set<string>();

      function renderMockStudentPicker() {
        const picker = $("mockStudentPicker");
        if (studentsCache.length === 0) {
          picker.innerHTML = `<p class="empty-text">등록된 학생이 없습니다.</p>`;
          return;
        }
        picker.innerHTML = studentsCache
          .map(
            (s) => `
              <button type="button" class="student-toggle ${mockSelectedStudentIds.has(s.id) ? "selected" : ""}" data-id="${s.id}">
                ${escapeHtml(s.name)}
              </button>
            `
          )
          .join("");
        picker.querySelectorAll<HTMLButtonElement>(".student-toggle").forEach((btn) =>
          btn.addEventListener("click", () => {
            const id = btn.dataset.id!;
            if (mockSelectedStudentIds.has(id)) mockSelectedStudentIds.delete(id);
            else mockSelectedStudentIds.add(id);
            btn.classList.toggle("selected");
          })
        );
      }

      function mockStatusLabel(status: string): string {
        if (status === "assigned") return "배정됨 (대기 중)";
        if (status === "in_progress") return "진행 중";
        return "완료";
      }

      async function loadMockAssignments() {
        const { data, error } = await supabase
          .from("mock_sessions")
          .select("id, student_id, status, started_at, followup_enabled")
          .order("started_at", { ascending: false });
        const list = $("mockAssignList");
        if (error) {
          list.innerHTML = `<p class="empty-text">불러오기에 실패했습니다.</p>`;
          console.error(error);
          return;
        }
        if (!data || data.length === 0) {
          list.innerHTML = `<p class="empty-text">배정된 모의면접이 없습니다.</p>`;
          return;
        }
        list.innerHTML = data
          .map((row: any) => {
            const name = studentsCache.find((s) => s.id === row.student_id)?.name ?? "알 수 없음";
            return `
              <div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                <div>
                  <p class="student-mgmt-name" style="margin-bottom:2px">${escapeHtml(name)}</p>
                  <p class="student-mgmt-meta">${mockStatusLabel(row.status)} · 꼬리질문 ${row.followup_enabled ? "ON" : "OFF"} · ${new Date(row.started_at).toLocaleString("ko-KR")}</p>
                </div>
                <button class="btn-delete delete-mock-assignment" data-id="${row.id}" style="flex-shrink:0">삭제</button>
              </div>
            `;
          })
          .join("");
        list.querySelectorAll<HTMLButtonElement>(".delete-mock-assignment").forEach((btn) =>
          btn.addEventListener("click", async () => {
            const id = btn.dataset.id!;
            const row = (data as any[]).find((r) => r.id === id);
            const started = row && row.status !== "assigned";
            const message = started
              ? "이 모의면접 기록을 삭제할까요?\n\n학생이 녹음한 답변과 받아쓰기 내용도 함께 삭제되며 복구할 수 없습니다."
              : "이 모의면접 배정을 취소할까요?";
            if (!confirm(message)) return;

            const { data: items } = await supabase.from("mock_session_items").select("audio_path").eq("session_id", id);
            const { error } = await supabase.from("mock_sessions").delete().eq("id", id);
            if (error) {
              alert("삭제에 실패했습니다: " + error.message);
              return;
            }
            await removeRecordings(((items ?? []) as any[]).map((i) => i.audio_path));
            loadMockAssignments();
          })
        );
      }

      $("mockAssignSubmit").addEventListener("click", async () => {
        if (mockSelectedStudentIds.size === 0) {
          alert("대상 학생을 한 명 이상 선택해주세요.");
          return;
        }
        const followupEnabled = $<HTMLInputElement>("mockFollowupToggle").checked;
        const rows = [...mockSelectedStudentIds].map((student_id) => ({
          student_id,
          planned_duration_seconds: 600 + Math.floor(Math.random() * 301),
          status: "assigned",
          followup_enabled: followupEnabled,
        }));
        const { error } = await supabase.from("mock_sessions").insert(rows);
        if (error) {
          alert("모의면접 배정에 실패했습니다: " + error.message);
          return;
        }
        mockSelectedStudentIds.clear();
        renderMockStudentPicker();
        loadMockAssignments();
      });

      // ── 추가/수정 모달 ──
      let editingId: string | null = null;

      function openAddModal() {
        editingId = null;
        $("studentModalTitle").textContent = "학생 추가";
        $<HTMLInputElement>("fieldName").value = "";
        $<HTMLInputElement>("fieldPassword").value = "";
        $<HTMLTextAreaElement>("fieldSchool").value = "";
        $("passwordHint").classList.add("hidden");
        $("studentFormError").textContent = "";
        $("studentModal").classList.add("show");
      }

      function openEditModal(id: string) {
        const s = studentsCache.find((x) => x.id === id);
        if (!s) return;
        editingId = id;
        $("studentModalTitle").textContent = "학생 수정";
        $<HTMLInputElement>("fieldName").value = s.name;
        $<HTMLInputElement>("fieldPassword").value = "";
        $<HTMLTextAreaElement>("fieldSchool").value = s.school ?? "";
        $("passwordHint").classList.remove("hidden");
        $("studentFormError").textContent = "";
        $("studentModal").classList.add("show");
      }

      function closeStudentModal() {
        $("studentModal").classList.remove("show");
      }

      $("addStudentBtn").addEventListener("click", openAddModal);
      $("studentModalCancel").addEventListener("click", closeStudentModal);

      // 엑셀 등에서 붙여넣은 전각 쉼표(，)를 일반 쉼표로 바꾸고 각 칸 앞뒤 공백을 정리
      function normalizeApplications(raw: string): { text: string | null; noCommaLines: string[] } {
        const lines = raw
          .replace(/[，、]/g, ",")
          .split("\n")
          .map((line) => line.split(",").map((part) => part.trim()).join(",").trim())
          .filter(Boolean);
        return { text: lines.length ? lines.join("\n") : null, noCommaLines: lines.filter((l) => !l.includes(",")) };
      }

      $("studentModalSave").addEventListener("click", async () => {
        const name = $<HTMLInputElement>("fieldName").value.trim();
        const password = $<HTMLInputElement>("fieldPassword").value.trim();
        const { text: school, noCommaLines } = normalizeApplications($<HTMLTextAreaElement>("fieldSchool").value);
        const errorEl = $("studentFormError");

        if (!name) {
          errorEl.textContent = "이름을 입력해주세요.";
          return;
        }
        if (!editingId && !password) {
          errorEl.textContent = "신규 등록 시 비밀번호는 필수입니다.";
          return;
        }
        // 학생 로그인 화면은 숫자 4자리 PIN만 입력받으므로 그 외의 값은 로그인이 불가능함
        if (password && !/^\d{4}$/.test(password)) {
          errorEl.textContent = "비밀번호는 숫자 4자리여야 합니다.";
          return;
        }
        if (noCommaLines.length > 0) {
          const ok = confirm(
            `쉼표(,) 없이 입력된 줄이 있습니다:\n${noCommaLines.join("\n")}\n\n이대로 저장하면 학교명만 저장되고 전형/학과/면접일은 비어 있게 됩니다.\n(작성형식: 학교명,전형,학과,면접일)\n\n그래도 저장할까요?`
          );
          if (!ok) return;
        }

        const btn = $<HTMLButtonElement>("studentModalSave");
        btn.disabled = true;

        let error;
        if (editingId) {
          // 비밀번호가 거부되면 다른 정보도 저장되지 않도록 비밀번호를 먼저 처리
          if (password) {
            ({ error } = await supabase.rpc("admin_set_student_password", { p_id: editingId, p_password: password }));
          }
          if (!error) {
            ({ error } = await supabase.rpc("admin_update_student", {
              p_id: editingId,
              p_name: name,
              p_school: school,
              p_grade: null,
            }));
          }
        } else {
          ({ error } = await supabase.rpc("admin_create_student", {
            p_name: name,
            p_school: school,
            p_grade: null,
            p_password: password,
          }));
        }

        btn.disabled = false;

        if (error) {
          errorEl.textContent = "저장에 실패했습니다: " + error.message;
          return;
        }

        closeStudentModal();
        loadStudents();
      });

      // ── 삭제 모달 ──
      let deletingId: string | null = null;

      function openDeleteModal(id: string) {
        deletingId = id;
        $("deleteStudentModal").classList.add("show");
      }
      $("deleteCancel").addEventListener("click", () => $("deleteStudentModal").classList.remove("show"));
      $("deleteConfirm").addEventListener("click", async () => {
        if (!deletingId) return;
        const id = deletingId;
        deletingId = null; // 연타해도 한 번만 실행
        $("deleteStudentModal").classList.remove("show");

        // 학생 행이 지워지면 녹음 경로를 알 수 없게 되므로 삭제 전에 미리 모아둠
        const [{ data: answers }, { data: sessions }] = await Promise.all([
          supabase.from("custom_answers").select("audio_path").eq("student_id", id),
          supabase.from("mock_sessions").select("mock_session_items(audio_path)").eq("student_id", id),
        ]);
        const audioPaths = [
          ...((answers ?? []) as any[]).map((a) => a.audio_path),
          ...((sessions ?? []) as any[]).flatMap((s) => (s.mock_session_items ?? []).map((i: any) => i.audio_path)),
        ];

        const { error } = await supabase.rpc("admin_delete_student", { p_id: id });
        if (error) {
          alert("삭제에 실패했습니다: " + error.message);
          return;
        }
        await removeRecordings(audioPaths);
        loadStudents();
      });

      loadStudents();
      loadCommonQuestions();
    </script>
  </body>
</html>
